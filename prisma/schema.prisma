// Pepscore database schema
// Run: npx prisma db push   (to sync with Neon)
//      npx prisma generate  (to regenerate the client)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  complianceLogs ComplianceAcknowledgment[]
  // Optional 1:1 — see Customer.userId below for the linking rules.
  customer       Customer?

  @@index([email])
}

enum Role {
  CUSTOMER
  ADMIN
}

// ─── Products ────────────────────────────────────────────────────────────────

// Owner-controlled merchandising label (2026-08-15), mutually exclusive by
// design -- a product shows at most one of these on the storefront, never
// both. Deliberately NOT computed from sales/order volume this sprint --
// admin picks it manually via Product Master and it stays picked until
// changed.
enum MerchandisingStatus {
  NONE
  POPULAR
  BEST_SELLER
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  size        String
  price       Float
  bulkPrice5  Float?
  bulkPrice10 Float?
  description String
  imageUrl    String
  badge       String?
  inStock     Boolean  @default(true)
  costOfGoods Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── Case/SPA/Individual pricing (Inventory & Pricing MVP) ─────────────────
  // `price`/`bulkPrice5`/`bulkPrice10` above are the legacy flat-per-vial
  // model the storefront and today's invoice-item datalist still read —
  // deliberately untouched. Everything below is additive: a product with all
  // of these null behaves exactly as it did before this sprint. Suggested
  // values are always formula output (see lib/pricing/engine.ts); active
  // values are what actually gets charged and are never auto-replaced when
  // supplierCaseCost changes or the formula is recalculated — see
  // docs/Decisions.md for the manual-override-always-wins rule this sprint
  // introduced.
  sku                          String?              @unique
  supplierCaseCost             Float?
  unitsPerCase                 Int?
  suggestedStandardCasePrice   Float?
  activeStandardCasePrice      Float?
  suggestedSpaCasePrice        Float?
  activeSpaCasePrice           Float?
  suggestedBulkPrice           Float?
  activeBulkPrice              Float?
  suggestedIndividualVialPrice Float?
  activeIndividualVialPrice    Float?
  // Presence of activeIndividualVialPrice never implies this is true — an
  // admin must explicitly flip it. See CustomerContactEditor precedent:
  // storing a value and exposing it are deliberately separate decisions.
  individualSalesEnabled       Boolean              @default(false)
  manualPricingOverride        Boolean              @default(false)
  pricingOverrideReason        String?
  pricingNotes                 String?
  lastPricingReviewAt          DateTime?
  pricingStatus                ProductPricingStatus @default(ACTIVE)

  // ─── Physical inventory (vials) ─────────────────────────────────────────
  // physicalStockOnHand null + inventoryTrackingEnabled true means "awaiting
  // initialization" -- never defaulted to 0, per the standing rule that
  // opening quantities are never invented. reservedUnits/inventoryStatus are
  // live caches recomputed by lib/inventory/* after every ledger write; the
  // InventoryLedgerEntry rows are the source of truth, same pattern as
  // Invoice.amountRefunded/InvoiceRefund.
  inventoryTrackingEnabled Boolean                @default(false)
  physicalStockOnHand      Int?
  reservedUnits            Int                    @default(0)
  lowStockThreshold        Int?
  inventoryStatus          ProductInventoryStatus @default(TRACKING_DISABLED)
  // Catalog/inventory-level backorder configuration (Phase 2B correction,
  // 2026-08-07) -- explicitly distinct from BackorderCondition, which
  // records a specific invoice line's fulfillment shortage after a sale.
  // This field answers a different question, asked *before* any sale
  // exists: "can this product still be ordered when available physical
  // inventory is zero?" Admin-editable per product/strength, no code
  // deployment required. See lib/storefront/availability.ts's
  // getStorefrontAvailability(), which reads this alongside inventory
  // status rather than ever inferring it from another customer's
  // in-flight order. Represents STANDARD CASE fulfillment specifically as
  // of 2026-08-15 (see individualVialBackorderEnabled below) -- kept under
  // its original name/column rather than renamed to caseBackorderEnabled,
  // since a Prisma-schema rename would require recreating the data
  // (db push has no "rename" -- only drop+add) for no real benefit; "case"
  // fulfillment is also this field's original, only meaning before
  // single-vial purchasing existed as a separate concept.
  backorderEnabled         Boolean                @default(false)
  // Same concept as backorderEnabled above, but for the SINGLE VIAL sell
  // unit specifically (2026-08-15 sell-unit-level fulfillment). A single
  // Product row can now represent, e.g., "Single Vial ready to ship,
  // Standard Case produced to order" -- the two sell units of the same
  // strength are no longer forced to share one fulfillment state. Only
  // customer-visible when individualSalesEnabled is also true (see
  // lib/storefront/pricing.ts); independent of it otherwise -- direct
  // single-vial eligibility and single-vial fulfillment status are two
  // separate admin decisions, never derived from each other.
  individualVialBackorderEnabled Boolean          @default(false)

  // ─── SEO / Content Management (Phase 2B item 6) ─────────────────────────
  // All admin-editable via the storefront content editor
  // (components/admin/ProductContentSection.tsx) -- none of this requires a
  // code deployment to change. `description` (above) remains the short
  // description used on cards/list views and as the metaDescription
  // fallback; fullDescription is optional, longer detail-page copy that
  // falls back to `description` when unset so no existing product needs
  // re-entry. Never populated with supplier cost, suggested/internal
  // pricing, or admin notes -- this is the one editor whose output is
  // always publicly visible.
  seoTitle                    String?
  metaDescription             String?
  fullDescription             String?
  imageAltText                String?
  // Comma-separated extra search terms (e.g. common abbreviations) --
  // matched alongside name/size/category in lib/storefront/search.ts.
  searchSynonyms              String?
  // Array of { question, answer } objects, also used to emit FAQPage
  // structured data on the product detail page when non-empty.
  faq                         Json?
  // Slugs of other products to show in a "Related Products" section --
  // distinct from the automatic same-name sibling-strength list.
  relatedProductSlugs         String[] @default([])
  featured                    Boolean  @default(false)
  // Product-family-level, not per-strength (2026-08-15) -- when the admin
  // sets this from Product Master it's written to every Product row sharing
  // this name in one call (see SET_MERCHANDISING_STATUS in
  // app/api/admin/inventory/[id]/actions/route.ts), so a single mg
  // strength never drifts out of sync with its siblings. Distinct from
  // `featured` above (Phase 2B homepage-sort flag, its own separate
  // concept/badge) and from the legacy free-text `badge` column (no longer
  // read for storefront display -- see lib/storefront/groupByName.ts).
  merchandisingStatus         MerchandisingStatus @default(NONE)
  // Manual override, independent of the automatic completeness guard in
  // generateMetadata (a too-short/placeholder description forces noindex
  // regardless of this flag -- see app/products/[slug]/page.tsx).
  noindex                     Boolean  @default(false)
  // Replaces the computed AVAILABILITY_LABEL text when set (e.g.
  // "Restocking mid-August" instead of the generic "Coming Soon") --
  // never changes the underlying availability state itself.
  availabilityMessageOverride String?

  orderItems             OrderItem[]
  invoiceItems           InvoiceItem[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventoryReservations  InventoryReservation[]
  orderReservations      OrderReservation[]
  lowStockAlerts         LowStockAlert[]
  backorderConditions    BackorderCondition[]
  slugRedirects          ProductSlugRedirect[]
  priceChanges           ProductPriceChange[]
  inventoryPurchases     InventoryPurchase[]

  @@index([slug])
  @@index([inventoryStatus])
  @@index([pricingStatus])
}

// ─── Product Price Change History (Phase 3B) ────────────────────────────────
// Append-only audit record of every write to Product's active* price columns
// (the values actually charged) — a companion to InventoryLedgerEntry, same
// "auditable, never overwritten" discipline, but for price rather than
// physical stock. Written by lib/pricing/history.ts, called from
// setActivePricing() so every write path through that one function is
// captured with zero risk of a caller forgetting to log it. Denormalizes
// productName/productSize (strength) at time of change so history stays
// readable even if a product is later renamed or reclassified.
model ProductPriceChange {
  id            String              @id @default(cuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id])
  productName   String
  productSize   String
  sellUnit      PriceChangeSellUnit
  previousPrice Float?
  newPrice      Float?
  actorId       String
  source        PriceChangeSource
  reason        String?
  createdAt     DateTime            @default(now())

  @@index([productId, createdAt])
}

enum PriceChangeSellUnit {
  STANDARD_CASE
  SPA_CASE
  BULK
  INDIVIDUAL_VIAL
}

// Distinguishes which admin workflow produced the change — the pricing
// review page (per-product formula/active editor) vs. an invoice-line
// "Update Product Price" choice (Phase 3B item 3) vs. the one-off catalog
// seed scripts. Not exhaustive of every possible future source; extend as
// new authoritative write paths are added.
enum PriceChangeSource {
  ADMIN_PRICING_PAGE
  INVOICE_LINE_UPDATE_PRODUCT_PRICE
  CATALOG_SEED
}

// Preserves the prior canonical URL when an admin changes a product's slug
// via the content editor -- app/products/[slug]/page.tsx checks this table
// on a lookup miss and redirects rather than 404ing a URL that used to be
// real and may already be indexed/bookmarked/linked externally.
model ProductSlugRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum ProductPricingStatus {
  ACTIVE
  INACTIVE
}

enum ProductInventoryStatus {
  TRACKING_DISABLED
  AWAITING_INITIALIZATION
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

// ─── Inventory Ledger ────────────────────────────────────────────────────────
// Append-only, auditable record of every change to Product.physicalStockOnHand
// -- never delete or silently replace a row to "fix" a mistake, record a new
// REVERSAL/RECONCILIATION event that points back at what it corrects (same
// convention as BalanceTransfer's reversedAt-on-the-same-row and
// BackorderCondition's resolvedAt-on-the-same-row, except here the
// correction is itself always a new, separate ledger row so previousBalance/
// resultingBalance stay a truthful chain).
model InventoryLedgerEntry {
  id               String                @id @default(cuid())
  productId        String
  product          Product               @relation(fields: [productId], references: [id])
  skuSnapshot      String?
  quantityDelta    Int
  physicalUnit     InventoryPhysicalUnit @default(VIAL)
  previousBalance  Int
  resultingBalance Int
  eventType        InventoryEventType
  reason           String?

  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceItemId String?

  // [Roadmap] Storefront Order counterpart to invoiceId/invoiceItemId above
  // -- added for OrderReservation (see below) so a ledger entry driven by a
  // storefront checkout is auditable the same way an invoice-driven one is,
  // rather than a blind spot in this table. A given row is ever only
  // invoice-linked OR order-linked, never both.
  orderId     String?
  order       Order?  @relation(fields: [orderId], references: [id])
  orderItemId String?

  actor     String
  actorType InventoryActorType @default(ADMIN)
  notes     String?

  // Always generated by the service layer (never left to the caller) so
  // every write is safe to retry -- see lib/inventory/ledger.ts.
  idempotencyKey String @unique

  // One-to-one self-relation: a REVERSAL row points back at the entry it
  // corrects. Only ever set on creation, never mutated after.
  reversalOfId String?               @unique
  reversalOf   InventoryLedgerEntry? @relation("InventoryLedgerReversal", fields: [reversalOfId], references: [id])
  reversedBy   InventoryLedgerEntry? @relation("InventoryLedgerReversal")

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([invoiceId])
  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
}

enum InventoryPhysicalUnit {
  VIAL
}

enum InventoryEventType {
  INITIALIZE
  RESTOCK
  MANUAL_INCREASE
  MANUAL_DECREASE
  DAMAGE_LOSS
  RECONCILIATION
  RESERVATION
  RESERVATION_RELEASE
  FULFILLMENT_DEDUCTION
  BACKORDER_ALLOCATION
  REVERSAL
}

enum InventoryActorType {
  ADMIN
  SYSTEM
}

// ─── Inventory Reservations ─────────────────────────────────────────────────
// One row per invoice-item-level reservation of physical stock. Exists
// specifically so "fulfillment deduction exactly once" and "reservation
// release exactly once" are enforced by a status transition (ACTIVE ->
// FULFILLED or ACTIVE -> RELEASED) rather than by trusting a caller not to
// double-call a service function -- a second attempt against a
// non-ACTIVE row is a no-op, not a second deduction.
model InventoryReservation {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItemId String
  quantity      Int

  status ReservationStatus @default(ACTIVE)

  reservedAt  DateTime  @default(now())
  releasedAt  DateTime?
  fulfilledAt DateTime?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([invoiceId])
  @@index([invoiceItemId])
  @@index([status])
}

// [Roadmap] Storefront-Order counterpart to InventoryReservation above.
// Deliberately a SEPARATE model rather than making InventoryReservation's
// invoiceId/invoiceItemId optional and bolting on orderId/orderItemId --
// that model is mature and actively used in production by the admin
// invoice module (backorder handling, the reservation-correction admin
// panel); this new one exists so storefront checkout (real audit finding:
// app/api/checkout/route.ts never reserved or deducted stock at all,
// regardless of payment method) can get the same proven reserve/release/
// fulfill discipline without touching that working system. Reuses
// ReservationStatus and computeInventoryStatus()/Product.reservedUnits --
// the two models share the same underlying stock-accounting primitives,
// they just point at different parent records.
model OrderReservation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  quantity    Int

  status ReservationStatus @default(ACTIVE)

  reservedAt  DateTime  @default(now())
  releasedAt  DateTime?
  fulfilledAt DateTime?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
}

// ─── Low-Stock Alerts ────────────────────────────────────────────────────────
// One OPEN row per product at a time (service layer enforces "no duplicate
// unresolved alerts" -- never a unique constraint, since a resolved alert
// legitimately reopening later is a new row, preserving the full history).
model LowStockAlert {
  id               String              @id @default(cuid())
  productId        String
  product          Product             @relation(fields: [productId], references: [id])
  threshold        Int
  availableAtAlert Int
  status           LowStockAlertStatus @default(OPEN)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([productId])
  @@index([status])
}

enum LowStockAlertStatus {
  OPEN
  RESOLVED
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id])
  customerEmail         String
  customerName          String
  shippingAddress       Json
  status                OrderStatus       @default(PENDING)
  fulfillmentStatus     FulfillmentStatus @default(UNFULFILLED)
  stripeSessionId       String?           @unique
  stripePaymentIntentId String?
  subtotal              Float
  shippingCost          Float             @default(0)
  stripeFee             Float             @default(0)
  tax                   Float             @default(0)
  discountAmount        Float             @default(0)
  total                 Float
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Phase 4A Critical #1 -- the one promotion code applied to this order,
  // if any. Additive/nullable: every pre-existing Order row has both null.
  // A single nullable FK is a deliberate scope decision for this slice --
  // "standard promotions default to one promotion maximum" is the default
  // case this covers; true simultaneous 2-code stacking (Family & Friends
  // + one more) is scoped out as a follow-up (see docs/Decisions.md) even
  // though the compatibility-check logic itself already supports it.
  // Set at checkout creation (soft hold, PromotionCode.status stays ACTIVE
  // so an abandoned/failed order never permanently burns a one-time code),
  // only actually marked REDEEMED on real payment success.
  appliedPromotionCodeId String?       @unique
  appliedPromotionCode   PromotionCode? @relation(fields: [appliedPromotionCodeId], references: [id])

  items                  OrderItem[]
  invoice                Invoice?
  shippingLabel          ShippingLabel?
  payments               Payment[]
  complianceLogs         ComplianceAcknowledgment[]
  reservations           OrderReservation[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  achAuthorizations      AchAuthorization[]

  @@index([customerEmail])
  @@index([stripeSessionId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  FULFILLED
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String
  size        String
  quantity    Int
  unitPrice   Float
  costOfGoods Float   @default(0)
  total       Float

  // ─── Sell-unit awareness (Phase 3C reorder architecture) ──────────────────
  // Additive: every pre-existing OrderItem row has both null, meaning
  // "Standard Case" (checkout's only-ever-offered tier before this) --
  // reads of these two fields must always tolerate null, never assume a
  // real value on historical rows. Reuses InvoiceItemSellUnit rather than a
  // parallel enum, since it's the exact same tier concept already
  // established for invoices (CASE_STANDARD | CASE_SPA | CASE_BULK |
  // INDIVIDUAL_VIAL). unitsPerSellUnit is how many physical vials one unit
  // of `quantity` represents (10 for a Standard/SPA/Bulk Case, 1 for an
  // Individual Vial) -- checkout resolves and stores this at purchase time
  // so inventory reservation deducts the correct number of vials, not a
  // raw case count.
  sellUnit         InvoiceItemSellUnit?
  unitsPerSellUnit Int?

  @@index([orderId])
}

// ─── Invoices ────────────────────────────────────────────────────────────────
// The invoice module stands on its own: orderId is optional so an invoice can
// represent a Stripe-driven storefront sale (linked) OR a fully manual,
// off-platform sale (unlinked) — e.g. a DM/cash sale with no Order record.
// Customer/shipping fields are duplicated onto Invoice rather than requiring
// a User/Order so a manual invoice is self-contained and never blocked on
// those records existing.

model Invoice {
  id              String  @id @default(cuid())
  invoiceNumber   String  @unique
  orderId         String? @unique
  order           Order?  @relation(fields: [orderId], references: [id])
  stripeInvoiceId String?

  // The canonical, cross-invoice Customer record this invoice belongs to
  // (nullable — every invoice created before the CRM feature has no link).
  // Fields below stay a point-in-time snapshot even when this is set, since
  // an issued invoice must remain accurate to what was true when issued.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Set when this invoice/draft originated from a customer intake-link
  // submission — see docs/Decisions.md.
  intakeSubmittedAt DateTime?
  priority          InvoicePriority @default(NORMAL)

  // Permanent record of an admin bypassing the normal Fulfillment Gate
  // (paid in full / active payment arrangement) to ship anyway — set only
  // through lib/fulfillment/gate.ts's overrideFulfillmentEligibility(),
  // never a plain boolean, so who/when/why is never lost. See
  // docs/Decisions.md.
  fulfillmentOverrideAt   DateTime?
  fulfillmentOverrideBy   String?
  fulfillmentOverrideNote String?

  // Customer (snapshotted at invoice time, independent of User/Order)
  customerName    String
  customerCompany String?
  customerEmail   String?
  customerPhone   String?
  billingAddress  Json?
  shippingAddress Json?
  internalNotes   String?
  publicNotes     String?

  // Shipping / fulfillment
  carrier        ShippingCarrier?
  trackingNumber String?
  shippingCost   Float            @default(0)
  shipDate       DateTime?
  deliveryDate   DateTime?
  deliveredDate  DateTime?
  deliveryStatus DeliveryStatus   @default(PREPARING)

  // Carrier-agnostic tracking (see lib/tracking/) — deliveryStatus above is
  // left untouched for back-compat with existing invoices/UI; these are the
  // new normalized-status fields the tracking system actually drives.
  shippingService    String?
  trackingUrl        String?
  shippingStatus     ShippingStatus     @default(NOT_SHIPPED)
  lastTrackingUpdate DateTime?
  orderStatus        InvoiceOrderStatus @default(OPEN)

  // Denormalized snapshot of the most recent shipment notification, for
  // quick display without a join — full history lives in ShipmentNotification.
  lastNotificationType          ShippingStatus?
  lastNotificationStatus        String?
  lastNotificationSentAt        DateTime?
  lastNotificationRecipient     String?
  lastNotificationFailureReason String?

  // Denormalized snapshot of the most recent "invoice emailed to customer"
  // send (auto-sent once on first reaching ISSUED/PAID/PARTIALLY_PAID, or
  // manually resent anytime after) — same shape as the notification fields
  // above, full history lives in InvoiceActivityLog. Presence of an
  // INVOICE_ISSUED_EMAIL_SENT activity-log row is what gates the one-time
  // auto-send, not a separate boolean, so re-sending manually never confuses
  // "have we auto-sent yet."
  lastInvoiceEmailSentAt        DateTime?
  lastInvoiceEmailStatus        String?
  lastInvoiceEmailFailureReason String?

  // Financials — stored (not just derived) so history survives later price/promo edits
  subtotal       Float @default(0)
  discountTotal  Float @default(0)
  total          Float @default(0)
  amountPaid     Float @default(0)
  balanceDue     Float @default(0)
  // Set only when confirmed payments exceed total — see
  // lib/invoice/status.ts. Balance Due never goes negative; this is where
  // the excess is surfaced instead, for admin review.
  overpaidAmount Float @default(0)
  // Authoritative running total of *completed* refunds only (see
  // InvoiceRefund/RefundStatus below) — incremented exclusively by
  // lib/backorders.ts's completeRefund(), never at refund-request time.
  // Deliberately independent of amountPaid/balanceDue/total: a pending
  // refund must never retroactively rewrite what was actually billed or
  // paid, only a completed one is "real" enough to report here.
  amountRefunded Float @default(0)

  status                InvoiceStatus        @default(DRAFT)
  // Derived exclusively from confirmed InvoicePayment records — see
  // lib/invoice/status.ts's deriveInvoicePaymentStatus, recomputed
  // everywhere amountPaid changes. Never settable directly by an admin
  // dropdown (see docs/Decisions.md for the bug this replaces).
  paymentStatus         InvoicePaymentStatus @default(UNPAID)
  // Tracks the client's stated intention (pay-in-full selection or
  // arrangement request/approval), independent of PaymentStatus.
  paymentIntentStatus   PaymentIntentStatus  @default(NOT_AVAILABLE)
  // The client's *intended* method from a Pay in Full selection — distinct
  // from InvoicePayment.method, which records what was actually received.
  selectedPaymentMethod PaymentMethod?

  issuedAt   DateTime  @default(now())
  paidAt     DateTime?
  archivedAt DateTime?

  // [Roadmap] Archive metadata -- who/why/how this invoice was archived,
  // for the CURRENT archive event only (cleared to null on restore, same
  // present-tense semantics as archivedAt itself). The full history --
  // every past archive/restore, with timestamps -- lives in
  // InvoiceActivityLog (INVOICE_ARCHIVED/INVOICE_UNARCHIVED events), the
  // same append-only place every other invoice history fact already
  // lives; these three columns are a display convenience, not the
  // authoritative record, so restoring never "destroys" anything the
  // activity log doesn't already durably have.
  archiveReason String?
  archivedBy    String?
  archiveSource InvoiceArchiveSource?

  // Soft-delete holding spot, distinct from archivedAt: Archive is for
  // completed invoices you keep for records; this is for "get this out of my
  // list" with a recovery window before the separate, explicit permanent-delete
  // step actually removes the row. Never set alongside a restore of the other.
  deletedAt DateTime?

  // Generated on-demand (see lib/invoice/pdf); columns reserved for when
  // persistent blob storage is added — see docs/Decisions.md
  pdfMasterUrl    String?
  pdfRecipientUrl String?

  items              InvoiceItem[]
  discounts          InvoiceDiscount[]
  payments           InvoicePayment[]
  paymentArrangement PaymentArrangement?
  // One-to-many (not the historical 1:1) — every shipment ever created for
  // this invoice, including voided/replaced ones, is preserved forever. The
  // "primary/current" shipment is always derived (see lib/shipments/primary.ts),
  // never a stored pointer. See docs/Decisions.md.
  shipments          Shipment[]
  notifications      ShipmentNotification[]
  activityLog        InvoiceActivityLog[]
  fulfillmentAlerts  FulfillmentAlert[]

  // CRM/intake back-relations — see Customer/IntakeLink/Notification models below.
  customerActivityLog CustomerActivityLog[]
  intakeLinks         IntakeLink[]
  adminNotifications  Notification[]

  // Backorder back-relations — see the Backorders section below.
  backorderConditions    BackorderCondition[]
  backorderCompensations BackorderCompensation[]
  refunds                InvoiceRefund[]
  // Account credits that *originated from* this invoice (sourceInvoiceId) —
  // not the customer's full credit balance, which is queried via Customer.
  issuedAccountCredits   CustomerAccountCredit[]

  // Every email/SMS ever sent that referenced this invoice — see the
  // Correspondence History section below.
  communications Communication[]

  // ─── Balance Carryover (Phase 1B) ──────────────────────────────────────────
  // Authoritative-receivable bookkeeping for lib/balanceTransfers.ts. Both are
  // derived/cached totals recomputed transactionally by that module — same
  // "Invoice's own field is a live cache, the ledger row is the source of
  // truth" pattern as amountRefunded/InvoiceRefund above — never hand-edited.
  //
  // transferredOutAmount: how much of THIS invoice's balance has been moved
  // to another invoice (as the source). Subtracted from balanceDue at
  // transfer time so this invoice stops counting toward outstanding
  // receivables — never applied to amountPaid, which stays a pure record of
  // money actually received, per "preserve full historical payment data."
  transferredOutAmount Float @default(0)
  // carriedOverAmount: how much THIS invoice's total includes because it was
  // moved in from another invoice (as the destination) — added directly into
  // `total` (and therefore balanceDue) so the destination becomes the one
  // place that balance is actually collectible.
  carriedOverAmount    Float @default(0)

  balanceTransfersOut BalanceTransfer[] @relation("BalanceTransferSource")
  balanceTransfersIn  BalanceTransfer[] @relation("BalanceTransferDestination")

  // ─── Inventory & Pricing MVP ────────────────────────────────────────────
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventoryReservations  InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerEmail])
  @@index([customerName])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  // [Roadmap] Added for archive/history filtering at scale -- customerId
  // for a customer's own invoice history, archivedAt for the Active/
  // Archived/All filter tabs, paidAt for the auto-archive sweep's cutoff
  // comparison.
  @@index([customerId])
  @@index([archivedAt])
  @@index([paidAt])
}

// One row per transfer *event* — reversing never deletes or overwrites this
// row, it fills in reversedAt/reversedBy/reversalReason on the same record
// (matching BackorderCondition's "resolve fills in fields on the same row"
// precedent), so the full history of what moved where, and any later
// reversal, is always preserved. Never a plain mutable note/total on the two
// invoices — this ledger is what "explicit and audited" transfers means.
model BalanceTransfer {
  id String @id @default(cuid())

  sourceInvoiceId String
  sourceInvoice   Invoice @relation("BalanceTransferSource", fields: [sourceInvoiceId], references: [id], onDelete: Cascade)

  destinationInvoiceId String
  destinationInvoice   Invoice @relation("BalanceTransferDestination", fields: [destinationInvoiceId], references: [id], onDelete: Cascade)

  amount Float
  reason String?

  status BalanceTransferStatus @default(ACTIVE)

  transferredAt DateTime @default(now())
  transferredBy String

  reversedAt     DateTime?
  reversedBy     String?
  reversalReason String?

  createdAt DateTime @default(now())

  @@index([sourceInvoiceId])
  @@index([destinationInvoiceId])
}

enum BalanceTransferStatus {
  ACTIVE
  REVERSED
}

// Workflow lifecycle only — payment state lives in PaymentStatus below.
// PENDING is never set directly by an admin; it's the automatic overlay
// whenever an issued invoice still has Balance Due > $0 (see
// lib/invoice/status.ts's deriveInvoiceWorkflowStatus and docs/Decisions.md).
// APPROVED/PAID/PARTIALLY_PAID were removed from this enum — "approved"
// belongs to PaymentIntentStatus (an approved payment *arrangement*, never
// the invoice itself), and paid/partially-paid belong to PaymentStatus.
// REFUNDED/VOID are preserved, pre-existing terminal states, orthogonal to
// payment tracking and unused by the workflow described in docs/Decisions.md.
enum InvoiceStatus {
  DRAFT
  PENDING
  ISSUED
  CANCELLED
  REFUNDED
  VOID
  // TEMP-MIGRATION-PHASE-1: kept only until the two-phase data backfill
  // below completes, then removed in phase 2 — see the migration note in
  // this PR's description. Do not build new code against these three.
  APPROVED
  PAID
  PARTIALLY_PAID
}

// Derived exclusively from confirmed InvoicePayment records — never settable
// directly by an admin UI control. See lib/invoice/status.ts. Named
// InvoicePaymentStatus (not PaymentStatus) to avoid colliding with the
// pre-existing Stripe-order PaymentStatus enum below.
enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  // Not yet driven by any automated logic in this pass (no refund workflow
  // exists) — reserved so a future refund feature has a home without another
  // schema change.
  REFUNDED
  OVERPAID
}

// Tracks the client's stated *intention* and any arrangement's approval
// state — distinct from PaymentStatus (which only reflects money actually
// confirmed received). Never implies a payment was received.
enum PaymentIntentStatus {
  NOT_AVAILABLE
  AWAITING_CLIENT_SELECTION
  AWAITING_MANUAL_CONFIRMATION
  ARRANGEMENT_APPROVAL_PENDING
  ARRANGEMENT_APPROVED
  ARRANGEMENT_DENIED
  CONFIRMED
  CANCELLED
}

// A client-submitted arrangement request must be reviewed before it's
// active — see lib/paymentArrangements.ts. An admin-created arrangement
// (the pre-existing direct-create path) is stored as APPROVED immediately,
// unchanged from today's behavior.
enum ArrangementRequestStatus {
  REQUESTED
  APPROVED
  DENIED
}

enum ShippingCarrier {
  USPS
  UPS
  FEDEX
  DHL
  PICKUP
  HAND_DELIVERY
  COURIER
  OTHER
}

enum DeliveryStatus {
  PREPARING
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
  LOST
  DAMAGED
}

// Normalized, carrier-agnostic shipping status — every provider adapter in
// lib/tracking/ maps its own carrier-specific status vocabulary onto this
// fixed set, so nothing downstream (UI, PDF, email, reporting) needs to know
// which carrier or provider is actually involved.
enum ShippingStatus {
  NOT_SHIPPED
  TRACKING_ADDED
  LABEL_CREATED
  CARRIER_AWAITING_PACKAGE
  ACCEPTED_BY_CARRIER
  IN_TRANSIT
  DELAYED
  DELIVERY_EXCEPTION
  AVAILABLE_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED_TO_SENDER
  DELIVERY_ATTEMPTED
  LOST
  CANCELLED
  UNKNOWN
}

// The 4th status dimension the tracking spec calls for, kept independent of
// InvoiceStatus (payment) and ShippingStatus/deliveryStatus (fulfillment) —
// named InvoiceOrderStatus, not OrderStatus, since that name is already taken
// by the separate Stripe Order model's status enum.
enum InvoiceOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// [Roadmap] Distinguishes an admin's deliberate Archive click from the
// daily automatic sweep (lib/invoices.ts's sweepAutoArchive) -- see
// Invoice.archiveSource.
enum InvoiceArchiveSource {
  ADMIN
  SYSTEM
}

// Manual triage priority for the Awaiting Fulfillment queue — bumped inline,
// no separate assignment/triage system.
enum InvoicePriority {
  LOW
  NORMAL
  HIGH
}

// Where a tracking/activity event originated — surfaced in the invoice
// activity log per spec ("Source: Manual, Webhook, Polling, or System").
enum TrackingEventSource {
  MANUAL
  WEBHOOK
  POLLING
  SYSTEM
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  name         String
  description  String?
  quantity     Int      @default(1)
  unitPrice    Float
  lineDiscount Float    @default(0)
  total        Float
  sortOrder    Int      @default(0)

  // ─── Inventory & Pricing MVP (all additive/nullable -- every row created
  // before this sprint has all of these null and stays fully valid; the
  // audit run ahead of this sprint found only 2 of 21 historical rows even
  // have a productId, and quantity's meaning (cases vs. vials) can't be
  // reliably reconstructed for those, so nothing here is ever backfilled) ──
  sellUnit                  InvoiceItemSellUnit?
  unitsPerSellUnit          Int?
  priceTier                 InvoiceItemPriceTier?
  skuSnapshot               String?
  manualPricingOverride     Boolean               @default(false)
  // Vials actually deducted from inventory for this line -- snapshotted at
  // save time (quantity * unitsPerSellUnit for a case/SPA/bulk sell unit,
  // quantity for an individual vial) so a later catalog change to
  // unitsPerCase never rewrites what this specific sale actually consumed.
  inventoryQuantityConsumed Int?

  // 2026-08-12 (Finance & Expense Intelligence sprint) -- COGS for this
  // specific line, snapshotted at the time it's set so a later catalog
  // supplierCaseCost change never rewrites a past sale's actual cost basis.
  // Nullable, never backfilled for historical rows (see the comment above
  // this block -- the same "don't reconstruct what wasn't recorded"
  // precedent) -- a null value means "unknown," not "zero," and Finance
  // reporting must treat it that way (excluded from COGS totals, not
  // counted as $0 margin). OrderItem already has this exact field; Invoice
  // never did until now, which is why the real (Invoice-based) sales
  // history has had zero COGS tracking to date (see docs/PendingOwnerActions.md).
  costOfGoods Float?

  // Refunds issued specifically against this line (2026-08-14, item-level
  // refund sprint) -- a refund with invoiceItemId null on InvoiceRefund is
  // still a whole-invoice refund, exactly as before this field existed;
  // this back-relation only surfaces the item-scoped ones.
  refunds InvoiceRefund[]

  @@index([invoiceId])
}

enum InvoiceItemSellUnit {
  CASE_STANDARD
  CASE_SPA
  CASE_BULK
  INDIVIDUAL_VIAL
}

enum InvoiceItemPriceTier {
  STANDARD
  SPA
  BULK
  INDIVIDUAL
  MANUAL
}

// Reusable discount templates (e.g. "FF", "Gift", "Holiday Sale") so the
// same promo can be applied across many invoices without retyping terms.
model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  amount      Float
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  invoiceDiscounts InvoiceDiscount[]
}

enum PromotionType {
  FIXED
  PERCENTAGE
}

// Applied-discount snapshot. Stores its own label/type/amount independent of
// Promotion so editing or deleting a Promotion later never rewrites history
// on invoices that already used it.
model InvoiceDiscount {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  promotionId   String?
  promotion     Promotion?    @relation(fields: [promotionId], references: [id])
  label         String
  type          PromotionType
  amount        Float
  appliedAmount Float

  // Set only when this specific discount row is a backorder compensation
  // credit — the back-relation for BackorderCompensation.discountId.
  backorderCompensation BackorderCompensation?

  @@index([invoiceId])
}

model InvoicePayment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Float
  method          PaymentMethod
  referenceNumber String?
  paidAt          DateTime      @default(now())
  notes           String?

  // Set when this payment satisfies a scheduled installment (see
  // PaymentArrangement below) — lets an installment's "Paid" status point
  // back to the actual payment record that satisfied it.
  installment PaymentArrangementInstallment?

  // Refunds that were issued against this specific payment, if any.
  refunds InvoiceRefund[]

  @@index([invoiceId])
}

enum PaymentMethod {
  // NA is the default for invoices that haven't received a payment yet —
  // named NA (not "N/A") since enum identifiers can't contain a slash;
  // lib/invoice/format.ts formats it back to "N/A" for display.
  NA
  CASH
  COD
  CREDIT_CARD
  DEBIT_CARD
  APPLE_PAY
  PAYPAL
  BANK_TRANSFER
  STRIPE
  SQUARE
  CASH_APP
  VENMO
  ZELLE
  ACH
  WIRE
  CHECK
  CRYPTO
  OTHER
}

// ─── Backorders ──────────────────────────────────────────────────────────────
// Backordered is an internal operational condition, entirely separate from
// both the customer-facing fulfillment status (DeliveryStatus/ShippingStatus
// — while backordered, that stays PREPARING) and the invoice lifecycle
// status. Tracked at the line-item level (not invoice-level) because a
// single invoice may have some available items and some backordered ones,
// and "the invoice must identify the affected item" requires that
// granularity. One row per backorder *event*, never mutated away — resolving
// a backorder fills in resolvedAt/resolvedBy/resolutionNote on the same row
// rather than deleting it, so the full history (including past, already
// resolved backorders) is always preserved.
//
// Deliberately NOT a hard foreign key onto InvoiceItem: invoiceItem edits go
// through lib/invoice/rowSync.ts's upsert-by-id path (items are only ever
// updated or newly created, never blanket-replaced), so a live InvoiceItem
// row an active BackorderCondition points at will normally keep existing —
// but if an admin genuinely deletes that specific line item, this row must
// not be silently destroyed by a cascade. It carries its own snapshot
// (productName) so the record stays meaningful even if the InvoiceItem it
// originally pointed to is later removed.
model BackorderCondition {
  id            String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItemId String
  productName   String

  // Additive (Inventory & Pricing MVP) — nullable so every backorder raised
  // before real inventory tracking existed stays valid. Set only when the
  // backordered line item was tied to a tracked Product; vialsBackordered is
  // a snapshot (same reasoning as InvoiceItem.inventoryQuantityConsumed) so
  // a later change to the product's unitsPerCase never rewrites what this
  // specific backorder actually represents.
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  vialsBackordered Int?

  status                BackorderStatus @default(ACTIVE)
  expectedAvailableDate DateTime?
  appliedAt             DateTime        @default(now())
  appliedBy             String
  resolvedAt            DateTime?
  resolvedBy            String?
  resolutionNote        String?
  notes                 String?

  compensationLinks BackorderConditionCompensation[]

  @@index([invoiceId])
  @@index([invoiceItemId])
}

enum BackorderStatus {
  ACTIVE
  RESOLVED
}

// Which bucket the collected-money portion of a compensation goes into when
// the invoice's balance alone doesn't cover it — an explicit admin choice
// (docs: "do not force an automatic cash refund when no provider can
// execute it"), not an automatic default. REFUND still means "start a
// pending refund obligation," never an actual completed transfer.
enum CompensationDispositionPreference {
  REFUND
  ACCOUNT_CREDIT
}

enum BackorderCompensationType {
  AUTOMATIC
  DISCRETIONARY
}

// One compensation per genuinely separate delay, not one per affected item —
// multiple line items backordered as part of the same order delay share a
// single BackorderCompensation via the join table below, which is what makes
// "one $25 credit per invoice/order delay, not per item" both auditable and
// idempotent (applying compensation for a newly-backordered item on an
// invoice that already has an active compensation just links the join row;
// it never creates a second discount/refund/credit).
model BackorderCompensation {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // AUTOMATIC = the flat $25 policy credit (gated on the order exceeding the
  // $100 minimum -- see lib/invoice/backorder.ts's
  // isAutomaticCompensationEligible). DISCRETIONARY = an admin-entered
  // custom amount for real-time customer-service situations that don't
  // meet the automatic policy (lib/backorders.ts's
  // applyDiscretionaryAccommodation) -- a genuinely separate workflow, not
  // a substitute for the automatic one. Both can coexist on the same
  // invoice; idempotency (one-per-invoice) is scoped per type, not globally.
  compensationType BackorderCompensationType @default(AUTOMATIC)

  totalAmount           Float // the flat policy amount (AUTOMATIC, normally 25.00) or the admin-entered amount (DISCRETIONARY)
  creditAppliedAmount   Float                             @default(0) // portion applied as an InvoiceDiscount, reducing balance due
  // Portion *requested* as a refund of money already collected — a fixed
  // snapshot of the compensation's allocation plan at apply-time, not a
  // live mirror of the linked InvoiceRefund's own lifecycle (that record's
  // completedAmount is the only place "money actually returned" is tracked).
  refundAmount          Float                             @default(0)
  accountCreditAmount   Float                             @default(0) // portion stored as a CustomerAccountCredit (exceeds what was actually paid)
  // Admin's chosen disposition for the collected-money portion when both a
  // refund and an account credit are theoretically possible (i.e. some
  // compensation exceeds balanceDue) — 'REFUND' still caps refundAmount at
  // amountPaid and pushes any further excess into accountCreditAmount
  // (the one case a "combination" happens), 'ACCOUNT_CREDIT' sends the
  // entire post-discount remainder to account credit and never creates a
  // refund at all. See lib/invoice/backorder.ts's computeCompensationSplit.
  dispositionPreference CompensationDispositionPreference @default(REFUND)

  reason    String
  appliedAt DateTime @default(now())
  appliedBy String

  // Set only when this specific compensation was later reversed/replaced
  // (e.g. a DISCRETIONARY amount the admin adjusted or removed) — the row
  // itself is never deleted or overwritten, matching the same
  // reversedAt-on-the-same-row convention used elsewhere in this schema
  // (BalanceTransfer). A reversed compensation's linked discountId is
  // detached (set null) and its InvoiceDiscount row deleted so the
  // invoice total no longer reflects it, but this row's own
  // totalAmount/reason/appliedAt/appliedBy stay exactly as they were at
  // the time, so the full history of what was granted and later undone
  // is always reconstructable.
  reversedAt     DateTime?
  reversedBy     String?
  reversalReason String?

  // Each of these is optional and independent -- a single compensation can
  // be a pure credit, a pure refund, a pure account credit, or a genuine mix
  // of two or three, matching whatever the invoice's payment state actually
  // supported at the moment compensation was applied.
  discountId      String?                @unique
  discount        InvoiceDiscount?       @relation(fields: [discountId], references: [id])
  refundId        String?                @unique
  refund          InvoiceRefund?         @relation(fields: [refundId], references: [id])
  accountCreditId String?                @unique
  accountCredit   CustomerAccountCredit? @relation(fields: [accountCreditId], references: [id])

  coveredConditions BackorderConditionCompensation[]

  @@index([invoiceId])
  @@index([invoiceId, compensationType])
}

// Join table: which specific backorder events a given compensation covers —
// the "store enough linkage to show which backorder conditions are covered
// by the invoice-level compensation" requirement, queryable in either
// direction.
model BackorderConditionCompensation {
  id                      String                @id @default(cuid())
  backorderConditionId    String
  backorderCondition      BackorderCondition    @relation(fields: [backorderConditionId], references: [id], onDelete: Cascade)
  backorderCompensationId String
  backorderCompensation   BackorderCompensation @relation(fields: [backorderCompensationId], references: [id], onDelete: Cascade)
  createdAt               DateTime              @default(now())

  @@unique([backorderConditionId, backorderCompensationId])
}

// A refund *obligation* against money that was actually collected — never
// used to represent money that was never received (that's a
// CustomerAccountCredit instead). Deliberately separate from InvoicePayment
// (a positive-only record of money coming in) rather than a negative-amount
// payment, so "total collected" and "total refunded" are never ambiguous
// from the same column's sign.
//
// Pepscore has no integrated online-payment/auto-refund provider yet, so
// creating this row is never itself "money returned" — it starts PENDING
// and stays that way (or moves through AWAITING_MANUAL_PROCESSING/
// PROCESSING) until a real payment provider confirms it, or an authorized
// admin records that they completed it manually (lib/backorders.ts's
// completeRefund()). requestedAmount is fixed at creation; completedAmount
// is only ever set at completion, and may differ from requestedAmount if
// only a partial amount was actually returned. A future online-payment
// webhook is expected to update *this same record* via its status/
// completedAmount/providerTransactionId fields — never spin up a second,
// parallel refund model.
model InvoiceRefund {
  id                    String          @id @default(cuid())
  invoiceId             String
  invoice               Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  requestedAmount       Float
  completedAmount       Float?
  status                RefundStatus    @default(PENDING)
  reason                String
  method                PaymentMethod?
  // Set once a real payment provider (or manual record-keeping) has a
  // reference id for the completed transaction — null until then.
  providerTransactionId String?
  relatedPaymentId      String?
  relatedPayment        InvoicePayment? @relation(fields: [relatedPaymentId], references: [id])

  // ─── Item-level refunds (2026-08-14) ──────────────────────────────────
  // null invoiceItemId = whole-invoice refund, the only kind this model
  // supported before this field existed; every prior row and every
  // backorder-compensation refund stays exactly as it was. A non-null
  // invoiceItemId scopes this refund to one InvoiceItem. The four value
  // fields below are a frozen snapshot computed once at request time
  // (lib/invoice/refundAllocation.ts) from that item's own historical
  // InvoiceItem.total and the invoice's InvoiceDiscount.appliedAmount
  // rows at that moment -- never recomputed later, so a subsequent
  // discount reversal or catalog price change can never rewrite what an
  // already-issued refund's numbers actually were.
  invoiceItemId      String?
  invoiceItem        InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  refundedQuantity   Int? // only meaningful when invoiceItemId is set and the line's quantity > 1
  grossItemValue     Float? // InvoiceItem.total at request time (already nets lineDiscount)
  allocatedDiscount  Float? // this item's proportional share of invoice-level InvoiceDiscount.appliedAmount
  effectivePaidValue Float? // grossItemValue - allocatedDiscount -- the true refund ceiling for this item

  requestedAt   DateTime  @default(now())
  requestedBy   String
  completedAt   DateTime?
  completedBy   String?
  failureReason String?
  cancelledAt   DateTime?
  cancelledBy   String?

  backorderCompensation BackorderCompensation?

  @@index([invoiceId])
  @@index([status])
  @@index([invoiceItemId])
}

enum RefundStatus {
  PENDING
  AWAITING_MANUAL_PROCESSING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// A stored, future-usable credit for a customer — used when compensation
// exceeds money actually collected on the invoice it originated from (e.g. a
// $25 backorder credit on an invoice where only $10 has been paid so far:
// $10 reduces the balance via InvoiceDiscount, the remaining $15 has no real
// money behind it to refund, so it becomes account credit instead of an
// invented refund). Requires a linked Customer -- an invoice with no
// customerId has nowhere durable to store the credit; that edge case needs
// manual admin handling rather than a silently-lost credit.
model CustomerAccountCredit {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount          Float
  remainingAmount Float
  reason          String
  // SetNull, not Cascade: a permanently-deleted invoice (the Trash ->
  // Permanent Delete flow, lib/invoices.ts's permanentlyDeleteInvoice) must
  // never take a customer's real, spendable credit down with it — the
  // credit simply loses its origin-invoice reference and keeps existing.
  sourceInvoiceId String?
  sourceInvoice   Invoice? @relation(fields: [sourceInvoiceId], references: [id], onDelete: SetNull)
  issuedAt        DateTime @default(now())
  issuedBy        String

  backorderCompensation BackorderCompensation?

  @@index([customerId])
}

// ─── Payment Arrangements (installment plans) ───────────────────────────────
// A reusable data model, not one-off form fields — deliberately separate rows
// per installment (not a JSON blob) so future features (overdue detection,
// reminders, a customer payment portal, finance reporting) can query/update
// individual installments without redesigning this layer. One arrangement
// per invoice; installment #1 is always the initial payment itself (created
// alongside the arrangement, immediately marked PAID and linked to its
// InvoicePayment), installments #2+ are the generated future schedule.

model PaymentArrangement {
  id                   String           @id @default(cuid())
  invoiceId            String           @unique
  invoice              Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  initialPaymentAmount Float
  initialPaymentDate   DateTime
  // Count of *future* installments after the initial payment (matches the
  // "Number of Remaining Payments" field) — installment #1 is the initial
  // payment, so an arrangement always has 1 + remainingPayments rows total.
  remainingPayments    Int
  frequency            PaymentFrequency

  // REQUESTED when the client submits a proposal (never auto-active);
  // APPROVED immediately when an admin creates one directly from the
  // dashboard (today's pre-existing behavior, unchanged) or after an admin
  // approves a REQUESTED one. hasActivePaymentArrangement() (Fulfillment
  // Gate) only ever counts APPROVED rows.
  status              ArrangementRequestStatus @default(APPROVED)
  // Client's proposed down payment at request time — informational only
  // until the admin actually records and confirms receipt of it via the
  // normal Record Payment flow; never counted toward amountPaid on its own.
  proposedDownPayment Float?
  requestedAt         DateTime?
  decidedAt           DateTime?
  decidedBy           String?
  denialReason        String?

  installments PaymentArrangementInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentArrangementInstallment {
  id                String             @id @default(cuid())
  arrangementId     String
  arrangement       PaymentArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  // 1-indexed; #1 is always the initial payment.
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  status            InstallmentStatus  @default(PENDING)
  paidAt            DateTime?

  // Links to the InvoicePayment that actually satisfied this installment
  // (set immediately for #1, set by recordPayment() for later ones once
  // matched to the next pending installment in order).
  paymentId String?         @unique
  payment   InvoicePayment? @relation(fields: [paymentId], references: [id])

  @@unique([arrangementId, installmentNumber])
  @@index([arrangementId])
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
}

enum InstallmentStatus {
  PENDING
  PAID
  // Not set automatically yet (no scheduled job in this pass) — reserved
  // for the "automatic overdue detection" future enhancement; the schema
  // already supports it without another migration.
  OVERDUE
}

// ─── Payments ────────────────────────────────────────────────────────────────
// [Roadmap] Payment-provider abstraction, Phase 1 (see lib/payments/types.ts
// and docs/Decisions.md's Payment Provider Abstraction entry). Storefront-
// side only -- entirely separate from InvoicePayment above, which is the
// admin invoice module's own manually-entered payment record with no live
// processor integration. stripePaymentIntentId/stripeFee stay exactly as
// they were (still what app/api/webhooks/stripe/route.ts's idempotency
// check and lib/export.ts key off of, unchanged) -- every field below is
// new, nullable-or-defaulted, and additive so no existing row or call site
// needed to change. providerTransactionId is the generic field a future
// non-Stripe provider (ACH via GoCardless, PayPal) will use instead of a
// provider-specific column; for today's only real provider it's populated
// with the same value as stripePaymentIntentId.

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  stripePaymentIntentId String        @unique
  amount                Float
  currency              String        @default("usd")
  status                PaymentStatus
  stripeFee             Float         @default(0)
  netAmount             Float         @default(0)
  createdAt             DateTime      @default(now())

  provider              PaymentProvider             @default(STRIPE)
  methodType            StorefrontPaymentMethodType @default(CARD)
  providerTransactionId String?                     @unique

  // Normalized processor-cost tracking (owner spec item 3) -- kept separate
  // from stripeFee/netAmount above rather than replacing them, since those
  // two are still what existing reporting reads; these are the provider-
  // agnostic equivalents for future ACH/other-provider fee shapes that
  // don't map cleanly onto "2.9% + $0.30".
  processorFeePercent Float?
  processorFeeFixed   Float?
  refundedAmount      Float     @default(0)
  settledAt           DateTime?
  payoutId            String?
  disputedAt          DateTime?
  completedAt         DateTime?

  // [Roadmap] ACH (Phase 2) -- safe DISPLAY metadata only, sourced from
  // Stripe's own payment_method_details.us_bank_account object (returned
  // to us, never entered by Pepscore Lab). Never the account/routing
  // number itself -- see AchAuthorization below for why raw bank
  // credentials never touch this database at all. Null for every
  // non-ACH payment.
  bankName         String?
  bankAccountLast4 String?
  bankAccountType  String?

  achAuthorization AchAuthorization?

  @@index([orderId])
  @@index([provider])
  @@index([status])
}

// [Roadmap] ACH (Phase 2) -- one row per ACH payment attempt, recording
// the evidence that this specific debit was actually authorized, per the
// owner spec's "Do not initiate an ACH debit without the required
// authorization" requirement. Every field here is either a provider-side
// reference (mandateId, stripePaymentMethodId) or metadata Stripe already
// returns (bank name/last4 live on Payment instead, since they're display
// concerns, not authorization evidence) -- Pepscore Lab never collects or
// stores a raw account/routing number, online-banking username/password,
// or Financial Connections credential; Stripe's own Checkout Session
// (Financial Connections or manual micro-deposit flow) is what actually
// collects and verifies the bank account, and only hands back these safe
// references.
model AchAuthorization {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  stripePaymentMethodId String?
  mandateId             String?

  // Bumped only if the authorization language/flow itself changes --
  // lets a later audit distinguish which version of the ACH consent
  // language a given customer actually agreed to.
  authorizationVersion String   @default("stripe-checkout-ach-v1")
  authorizedAt         DateTime @default(now())
  ipAddress            String?
  userAgent            String?

  // Never actually deleted -- a revoked authorization is evidence too
  // (proof Pepscore Lab stopped debiting once consent was withdrawn).
  revokedAt DateTime?
  revokedBy String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

enum PaymentProvider {
  STRIPE
  // Reserved for the ACH-provider evaluation (owner spec Phase 3) --
  // unused until a real adapter is built and this value is actually
  // written by one.
  GOCARDLESS
  PAYPAL
}

enum StorefrontPaymentMethodType {
  CARD
  ACH
  APPLE_PAY
  GOOGLE_PAY
  CASH_APP
  PAYPAL
  VENMO
}

enum PaymentStatus {
  PENDING
  // ACH/bank debits sit here between submission and the provider's
  // authoritative confirmation -- ownerSpec section 9's "do not mark Paid
  // immediately" requirement. Never used by the existing card flow, which
  // still goes PENDING -> SUCCEEDED directly via checkout.session.completed.
  PROCESSING
  AUTHORIZED
  SUCCEEDED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  // ACH-specific: the bank returned/reversed an already-processing debit
  // (insufficient funds, closed account, revoked authorization, etc.) --
  // distinct from FAILED (which never got as far as a bank attempt).
  RETURNED
  CANCELLED
  DISPUTED
}

// [Roadmap] Admin Payment Settings -- a single-row table (fixed id
// 'singleton', same upsert pattern as InvoiceSettings above) rather than
// per-flag env vars, since these need to be admin-editable at runtime
// without a redeploy. cardEnabled/achEnabled/cashAppEnabled/paypalEnabled
// are REAL gates: app/api/checkout/route.ts reads them to build Stripe
// Checkout's payment_method_types array ('card'/'us_bank_account'/
// 'cashapp'/'paypal' respectively -- all four are genuine Stripe Checkout
// payment method types, confirmed against the installed Stripe SDK's own
// type definitions, not assumed). applePayEnabled/googlePayEnabled are
// deliberately NOT independent Stripe Checkout parameters -- Stripe
// surfaces Apple Pay/Google Pay automatically whenever 'card' is enabled
// and the visitor's browser/device supports them, there's no separate
// opt-in for a Checkout Session. Those two fields exist so the settings
// page can show accurate readiness status -- never pass them to Stripe as
// if they were their own flag. Enabling paypalEnabled here only takes
// effect once PayPal is actually turned on for this Stripe account in the
// Stripe Dashboard (Settings > Payment methods) -- an owner action Stripe
// itself gates, not something this codebase can activate; if PayPal isn't
// enabled account-side, Stripe rejects the session creation and the
// existing error path (release the reservation, surface the error)
// handles it the same as any other Stripe API failure. venmoEnabled stays
// a pure readiness flag -- Venmo has no Stripe Checkout payment method
// type at all (confirmed against the SDK types); it's only available
// through PayPal's own separate merchant checkout integration, which
// isn't built and would need its own project, not a flag on this one.
model PaymentSettings {
  id String @id @default("singleton")

  cardEnabled      Boolean @default(true)
  achEnabled       Boolean @default(true)
  cashAppEnabled   Boolean @default(false)
  applePayEnabled  Boolean @default(false)
  googlePayEnabled Boolean @default(false)
  paypalEnabled    Boolean @default(false)
  venmoEnabled     Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// [Roadmap] One row per saved reusable payment method (card or bank
// account) a portal customer has added. Every field here is either a
// Stripe-side reference (stripePaymentMethodId) or safe display metadata
// Stripe itself returns (brand/last4/expiry, bank name/last4) -- never a
// raw card or account/routing number, matching the same boundary
// AchAuthorization already established. Soft-deleted (removedAt) rather
// than hard-deleted so "this customer once had a method on file, then
// removed it" stays a real, auditable fact instead of silently
// disappearing -- lib/payments/savedMethods.ts's list functions always
// filter to removedAt: null.
model SavedPaymentMethod {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  stripePaymentMethodId String                      @unique
  methodType            StorefrontPaymentMethodType
  isDefault             Boolean                     @default(false)

  cardBrand    String?
  cardLast4    String?
  cardExpMonth Int?
  cardExpYear  Int?

  bankName         String?
  bankAccountLast4 String?
  bankAccountType  String?

  createdAt DateTime  @default(now())
  removedAt DateTime?

  @@index([customerId])
}

// ─── Shipping ────────────────────────────────────────────────────────────────

model ShippingLabel {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  carrier        String
  service        String
  trackingNumber String
  labelUrl       String
  shippoLabelId  String?
  cost           Float
  createdAt      DateTime @default(now())
}

// ─── Invoice Shipment Tracking ───────────────────────────────────────────────
// Carrier-agnostic tracking for invoices (distinct from ShippingLabel above,
// which is a one-time label-purchase snapshot for Stripe-driven Orders only).
// See lib/tracking/ and docs/Decisions.md for the provider-abstraction design.
//
// One row per physical shipment — an invoice can have many (multiple
// packages, a replaced/corrected tracking number, a voided label that was
// never used). None are ever deleted. The "primary" shipment shown in the
// UI/PDF is always derived (most recent non-voided row, see
// lib/shipments/primary.ts) rather than a separate pointer field, so it can
// never drift out of sync with the real collection.

model Shipment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  carrier        ShippingCarrier
  service        String?
  trackingNumber String
  trackingUrl    String?

  normalizedStatus ShippingStatus @default(NOT_SHIPPED)
  carrierStatus    String?

  dateShipped         DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  lastCheckedAt DateTime?
  lastEventAt   DateTime?

  // Polling fallback skips shipments where this is false — cleared once a
  // shipment reaches a terminal status (delivered/returned/lost/cancelled).
  monitoringActive Boolean @default(true)

  // Which ShippingProvider adapter registered this, and its own tracking
  // object id — kept so a provider swap later can still resolve history.
  providerName       String?
  providerTrackingId String?

  // Distinguishes a real in-app Shippo label purchase from a manually-typed
  // tracking number (e.g. a hand-written label, or PICKUP/HAND_DELIVERY).
  // The fields below are only ever populated for LABEL_PURCHASE shipments.
  origin ShipmentOrigin @default(MANUAL_ENTRY)

  // Where the physical label actually came from — orthogonal to origin above
  // (origin is "did this app buy postage", labelSource is "which service
  // produced the label admin is holding"). A LABEL_PURCHASE shipment is
  // always SHIPPO (this app only integrates Shippo for in-app purchases);
  // MANUAL_ENTRY can be any of these, most commonly PIRATE_SHIP today.
  labelSource LabelSource?

  // Freeform admin note on this specific shipment (e.g. "customer requested
  // signature confirmation", "split into two boxes"). Never customer-facing.
  notes String?

  // Who manually typed this tracking number in, for MANUAL_ENTRY shipments —
  // mirrors purchasedBy below, which covers the LABEL_PURCHASE case. Also
  // captured in InvoiceActivityLog's TRACKING_ADDED row, but kept here too so
  // the shipment card can show it without a second query.
  enteredBy String?

  shippoShipmentId    String?
  shippoTransactionId String?
  postageAmount       Float?
  // What's actually attributed/charged on the invoice for this shipment —
  // may differ from postageAmount (markup, rounding), same concept as the
  // existing Invoice.shippingCost field, but per-shipment.
  shippingCost        Float?
  labelUrl            String?
  labelPdfUrl         String?

  // Printerless USPS/Royal Mail/Evri label support (see lib/shippo.ts) —
  // qrCodeRequested reflects whether this purchase asked Shippo for one
  // (harmless to request even for a non-eligible carrier); qrCodeUrl is only
  // ever populated when Shippo's response actually included one, since
  // eligibility depends on the specific carrier/service that got purchased,
  // not just the request. labelUrl above is always populated regardless —
  // a QR-eligible purchase gets both, so "printable label" is never lost as
  // a fallback per the spec's "never silently swap" requirement.
  qrCodeRequested Boolean @default(false)
  qrCodeUrl       String?

  // Package details as entered/measured for this specific purchase — kept
  // as their own fields (not folded into a form-only value) so a future
  // scale integration only needs to produce the same shape.
  weightOz Float?
  lengthIn Float?
  widthIn  Float?
  heightIn Float?

  purchasedAt DateTime?
  purchasedBy String?
  // Shippo supports refunding/voiding a label within a window — set instead
  // of deleting, so the row (and its cost) stays in the permanent record.
  voidedAt    DateTime?
  voidedBy    String?

  events        TrackingEvent[]
  notifications ShipmentNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([trackingNumber])
  @@index([monitoringActive])
}

enum ShipmentOrigin {
  MANUAL_ENTRY
  LABEL_PURCHASE
}

// Which service actually produced the physical label — distinct from
// ShipmentOrigin (see the field comment on Shipment.labelSource above).
enum LabelSource {
  PIRATE_SHIP
  SHIPPO
  USPS_DIRECT
  UPS_DIRECT
  FEDEX_DIRECT
  OTHER_MANUAL
}

// One row per normalized carrier event, in provider-agnostic shape. Dedup is
// enforced at the DB level via the (shipmentId, eventHash) unique constraint —
// eventHash is the provider's own event id when available, otherwise a
// deterministic hash of (status, description, eventAt) so an out-of-order or
// re-delivered webhook/poll never creates a duplicate row.
model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  providerEventId  String?
  normalizedStatus ShippingStatus
  // Original carrier event text, preserved even though it's been mapped to a
  // normalizedStatus above — per spec, never discard the raw description.
  carrierStatus    String?
  description      String?
  location         String?
  eventAt          DateTime

  source    TrackingEventSource
  eventHash String

  createdAt DateTime @default(now())

  @@unique([shipmentId, eventHash])
  @@index([shipmentId])
}

// Full history of customer-facing shipment emails (Invoice's
// lastNotification* fields above are just a denormalized snapshot of the most
// recent row here, for quick display without a join).
model ShipmentNotification {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Which specific shipment this notification is about — required for
  // correct dedup now that an invoice can have multiple shipments (a second
  // shipment reaching DELIVERED must not be treated as "already notified"
  // just because a different, earlier shipment on the same invoice was).
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  notificationType ShippingStatus
  recipient        String
  status           String
  failureReason    String?

  sentAt DateTime @default(now())

  @@index([invoiceId])
  @@index([invoiceId, notificationType])
  @@index([shipmentId, notificationType])
}

// Dedicated activity log for shipment/tracking events on an invoice —
// deliberately separate from AdminAuditLog (which is shaped for admin-
// initiated CRUD actions like Archive/Trash and always requires an adminId).
// This log covers automated sources too (webhook/polling/system), so
// userId is optional.
model InvoiceActivityLog {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  eventType      String
  previousValue  String?
  newValue       String?
  carrier        ShippingCarrier?
  trackingNumber String?
  source         TrackingEventSource
  userId         String?

  // Which shipment this entry refers to, when relevant — plain id, no FK
  // relation (informational only, avoids yet another back-relation array on
  // Shipment for what's just a display detail).
  shipmentId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ─── Customers (CRM) ─────────────────────────────────────────────────────────
// Customer is the primary record intake links, notifications, and the
// timeline all hang off of — see docs/Decisions.md. Invoice keeps its own
// snapshotted name/company/email/phone/addresses (unchanged, above) since an
// issued invoice must stay accurate to what was true when it was issued even
// if the customer's info changes later; Customer is the current, canonical,
// cross-invoice record.

model Customer {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  company   String?
  email     String?
  phone     String?

  // [Roadmap] Saved payment methods -- created lazily (lib/payments/
  // savedMethods.ts) the first time this customer adds a payment method
  // in the portal, never eagerly for every Customer. Confirmed via audit
  // that no Stripe Customer object was ever created anywhere in this
  // codebase before this -- checkout has always been guest/email-based.
  stripeCustomerId String? @unique

  savedPaymentMethods SavedPaymentMethod[]

  // Optional link to the Clerk-authenticated storefront User this Customer
  // corresponds to. Null for admin-entered and intake-only customers (no
  // login) — that must keep working exactly as today. @unique enforces the
  // 1:1: a User can never end up linked to more than one Customer. No
  // explicit onDelete — same default (SetNull) already used by every other
  // optional User relation in this schema (Order.user, ComplianceAcknowledgment.user),
  // so deleting a User never deletes or cascades into Customer history.
  // Resolution/linking logic lives in lib/customers.ts, never inline here.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Admin kill-switch, independent of the userId link itself: lets an admin
  // instantly cut off portal access (e.g. a compromised session, a dispute)
  // without destroying the identity link — repair/re-enable is then just
  // flipping this back, not re-running the claim flow. Unlinking (userId =
  // null) is the separate, more drastic action for "this link is wrong."
  portalAccessDisabled Boolean @default(false)

  // Explicit SPA/wholesale pricing eligibility for the storefront (Phase 2B).
  // Never inferred from email domain, geography, name, or purchase history
  // -- only ever set by an admin action (lib/customers/spaEligibility.ts),
  // audited via CustomerActivityLog (SPA_ELIGIBILITY_GRANTED/_REVOKED)
  // rather than new dedicated columns, matching how every other admin
  // action in this schema is already audited.
  spaEligible Boolean @default(false)

  // [Roadmap] Twilio A2P 10DLC readiness -- set only via an inbound STOP
  // (or START to reverse) reply on app/api/webhooks/twilio/route.ts, never
  // directly by an admin. Checked by lib/notifications/log.ts's
  // sendCategorizedSms() before every customer-facing send (never affects
  // admin-recipient alerts that merely reference this customer). The "when"
  // lives on the CustomerActivityLog SMS_OPTED_OUT/SMS_OPTED_IN entry this
  // always writes alongside it, matching portalAccessDisabled's precedent
  // of a plain boolean with no redundant companion timestamp column.
  smsOptedOut Boolean @default(false)

  billingAddress  Json?
  shippingAddress Json?

  preferredContactMethod PreferredContactMethod?
  preferredPaymentMethod PaymentMethod?
  notes                  String?

  // Recomputed at the same touchpoints that write CustomerActivityLog below
  // (mirrors the existing computeOrderStatus pattern) — see
  // lib/customers.ts's computeCustomerStatus(). Never derived at read time,
  // so filtering/sorting by status is a plain indexed column.
  status CustomerStatus @default(LEAD)

  // Phase 2B item 8 (2026-08-07) -- a separate, admin-editable CRM triage
  // status (New/Contacted/Qualified/Converted/Closed), deliberately NOT
  // reusing `status` above: that field is fulfillment-lifecycle state,
  // automatically recomputed from invoice/payment/shipment events and never
  // admin-settable directly. leadStatus is the opposite -- never
  // auto-computed, only ever changed by an explicit admin action (see
  // app/api/admin/customers/[id]/route.ts), independent of whatever the
  // customer's actual order history looks like.
  leadStatus LeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices             Invoice[]
  intakeLinks          IntakeLink[]
  activityLog          CustomerActivityLog[]
  notifications        Notification[]
  accountCredits       CustomerAccountCredit[]
  communications       Communication[]
  portalInvites        CustomerPortalInvite[]
  accessEvents         CustomerAccessEvent[]
  identityReviewCases  CustomerIdentityReviewCase[]
  leadCaptures         LeadCapture[]
  firstOrderOfferClaim FirstOrderOfferClaim?
  promotionCodes       PromotionCode[]

  @@index([email])
  @@index([phone])
  @@index([status])
}

// Phase 2B item 7 -- one row per storefront lead-capture submission
// (contextual interest forms: general updates, launch notification,
// product/strength interest, notify-when-available, out-of-stock
// interest, pricing-review interest, SPA/wholesale inquiry). Always
// linked to a Customer via lib/leads/service.ts's captureLead(), which
// reuses the existing upsertCustomerFromIntake() find-or-create logic
// (lib/customers.ts) so a repeat submitter by the same email/phone never
// creates a second Customer row -- multiple LeadCapture rows can (and
// should) point at the same Customer over time, one per submission, so
// interest history is never overwritten.
model LeadCapture {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  interestType LeadInterestType

  // Product/strength context -- denormalized (name/size snapshotted, not
  // just a Product relation) so a lead's context stays legible even if the
  // product is later renamed, re-sized, or deactivated. productSlug is kept
  // for an admin to still jump to the live product when it still exists.
  productSlug String?
  productName String?
  productSize String?

  message String?

  // Attribution -- captured client-side at submission time (see
  // lib/storefront/attribution.ts's first-touch localStorage capture).
  // sourcePage is the page the form was actually submitted from (always
  // present); the rest describe how the visitor originally arrived, which
  // is often a different page/session than the submission itself.
  sourcePage  String
  referrer    String?
  landingUrl  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Captured at the same instant as this row, so no separate timestamp
  // column is needed -- createdAt below is the consent timestamp.
  consent Boolean @default(false)

  createdAt DateTime @default(now())

  firstOrderOfferClaim FirstOrderOfferClaim?

  @@index([customerId])
  @@index([interestType])
  @@index([createdAt])
}

enum LeadInterestType {
  GENERAL_UPDATES
  LAUNCH_NOTIFICATION
  PRODUCT_INTEREST
  NOTIFY_WHEN_AVAILABLE
  OUT_OF_STOCK_INTEREST
  PRICING_REVIEW_INTEREST
  SPA_WHOLESALE_INQUIRY
  // Sell-unit-availability inquiry (2026-08-15 fulfillment/availability
  // sprint) -- a variant with Standard Case available but individual-vial
  // sales not directly enabled shows "Single Vial — Special Request"
  // instead of nothing; this is the interest type that inquiry submits.
  // Never auto-enables individualSalesEnabled -- purely an inbound inquiry.
  SINGLE_VIAL_SPECIAL_REQUEST
  // First-order 10% offer claim (see FirstOrderOfferClaim) -- every claim
  // also creates a LeadCapture row with this interest type so it shows up
  // in the same admin Leads/CRM list/filters as every other submission,
  // never a disconnected marketing database.
  FIRST_ORDER_OFFER
}

// [Roadmap] 10% first-order storefront offer ("FIRST10"). A singleton
// config row (lib/promotions/firstOrderOffer.ts always reads/writes the one
// row via findFirst, creating it on first access) rather than a full
// admin-managed catalog like Promotion above -- this offer has exactly one
// live instance at a time, not a reusable per-invoice preset, and needs
// eligibility/expiration/stacking fields Promotion has no concept of.
// `enabled` defaults to false so shipping this schema + admin UI carries
// zero storefront behavior change until an admin explicitly turns it on --
// no owner action required to build this safely, since it's schema/config
// only, not a payment activation.
model FirstOrderOfferConfig {
  id String @id @default("singleton")

  enabled    Boolean @default(false)
  percentage Float   @default(10)

  // Empty array = every product is eligible. Non-empty = allow-list of
  // product slugs (matches Product.slug), letting an admin scope the offer
  // (e.g. exclude backordered/limited items) without a code deploy.
  eligibleProductSlugs String[] @default([])

  expiresAt DateTime?
  stackable Boolean   @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?

  claims FirstOrderOfferClaim[]
}

// One row per customer who has claimed the first-order offer. customerId is
// @unique so the database itself enforces one-claim-per-customer --
// claimFirstOrderOffer() is written to be idempotent on a repeat claim by
// the same customer (returns the existing claim rather than erroring), but
// this constraint is what actually prevents a race from ever producing two.
model FirstOrderOfferClaim {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  configId String
  config   FirstOrderOfferConfig @relation(fields: [configId], references: [id])

  // Nullable/additive -- any claim created before the Promotion Campaign
  // system existed (none exist in production as of this migration) would
  // have no campaign to point at; every claim going forward sets this.
  campaignId String?
  campaign   PromotionCampaign? @relation(fields: [campaignId], references: [id])

  // The unique single-redemption code issued alongside this claim.
  // Deliberately NOT @unique at the DB level (unlike PromotionCode.code
  // itself) -- claimFirstOrderOffer() already guarantees one code per
  // claim by construction (both created in the same transaction, one call
  // site), and adding a DB-level unique constraint to an existing
  // populated table requires Prisma's --accept-data-loss flag even when
  // provably safe (a new nullable column), which isn't worth the
  // friction for a guarantee the application layer already provides.
  promotionCodeId String?
  promotionCode   PromotionCode? @relation(fields: [promotionCodeId], references: [id])

  // The LeadCapture row created alongside this claim (interestType
  // FIRST_ORDER_OFFER, see enum above) -- same submission, kept as two rows
  // rather than folded into LeadCapture so this claim's own redemption-
  // tracking fields below don't have to be bolted onto that general-purpose
  // model.
  leadCaptureId String      @unique
  leadCapture   LeadCapture @relation(fields: [leadCaptureId], references: [id])

  // Legacy -- superseded by the campaign/code's own discountType/
  // discountValue (PromotionCode, promotionCodeId above) now that the
  // claim flow reads from the Promotion Campaign system instead of
  // FirstOrderOfferConfig. Loosened from required to nullable (zero
  // existing rows in production at the time of this change, so no
  // backfill needed) rather than writing a misleading 0 for a
  // fixed-dollar campaign into a field literally named "percentage."
  percentage Float?
  consent    Boolean @default(false)

  // Set only once real checkout can apply discounts (roadmap items #164/
  // #165) -- distinguishes "claimed, never redeemed" from "claimed and
  // used" in reporting. Left null by every code path today.
  redeemedAt      DateTime?
  redeemedOrderId String?

  claimedAt DateTime @default(now())

  // 2026-08-12 (AOAI lead-capture/conversion sprint) -- supports the
  // first-purchase reminder cadence, mirroring CustomerPortalInvite's
  // identically-named/shaped fields. Never written outside
  // app/api/cron/first-order-offer-reminders/route.ts, which is not
  // registered in vercel.json's cron schedule -- built and safety-gated,
  // deliberately not yet live (see docs/PendingOwnerActions.md).
  remindersSent  Int       @default(0)
  lastReminderAt DateTime?

  @@index([configId])
}

enum PromotionCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  RETIRED
  ARCHIVED
}

enum PromotionCodeStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  REVOKED
}

// Combination policy for the default "one promotion per Order" rule --
// see lib/promotions/compatibility.ts (canCampaignsCombine) for the actual
// rule engine this drives, and docs/Decisions.md for the full reasoning.
// NOT_STACKABLE is the default for every campaign, including first-order
// acquisition offers (FIRST10/FIRST20/etc.) -- a campaign only becomes
// combinable through an explicit admin choice, never by default.
enum PromotionStackingPolicy {
  NOT_STACKABLE // default -- cannot combine with any other promotion
  STACKABLE_WITH_ONE // may combine with exactly one other eligible, non-NOT_STACKABLE promotion
  PRIVILEGED_STACKABLE // the "Family & Friends" class -- may combine with one other eligible promotion, but two PRIVILEGED_STACKABLE campaigns cannot combine with each other
}

// Reusable, admin-configurable acquisition-offer campaign system --
// generalizes the originally-hardcoded FIRST10 (10% first order) so the
// owner can create/schedule/activate/retire/archive campaigns and change
// the live offer without a deploy. Deliberately a separate model from
// Promotion (above), not an extension of it: Promotion is a flat, ad-hoc
// discount an admin manually applies to one invoice line at a time
// (percentage/fixed, no dates/eligibility/scheduling/code-issuance) --
// this is a marketing acquisition offer with its own lifecycle, audience
// rules, and unique single-redemption codes issued per qualifying
// customer. Reuses PromotionType (FIXED|PERCENTAGE) for its own discount
// shape rather than inventing a parallel enum. See docs/Decisions.md for
// the full reasoning.
//
// FirstOrderOfferConfig/Claim (above) are NOT rewired to read from this
// model in this same change -- that's a deliberately separate, later
// slice (code generation + discount email + Twilio double opt-in all land
// together). This model ships additive-only, with zero behavior change to
// the existing (currently-inert, never-issued-a-code) claim flow.
model PromotionCampaign {
  id String @id @default(cuid())

  // Internal-only, never shown to a customer.
  name String

  // Customer-facing copy -- the storefront/lead-capture/email surfaces
  // should read these rather than hardcoding offer language, so a new
  // campaign's copy takes effect the moment it's activated.
  publicTitle       String
  publicDescription String?

  discountType  PromotionType
  discountValue Float

  status    PromotionCampaignStatus @default(DRAFT)
  startsAt  DateTime?
  expiresAt DateTime?

  // Only one campaign should ever be the default general first-order
  // acquisition offer at a time -- enforced in lib/promotions/campaigns.ts
  // (transactionally demotes the prior default when a new one activates),
  // not a DB constraint, matching this codebase's existing
  // singleton-invariant pattern (PortalRolloutSettings) of enforcing
  // uniqueness at the service layer rather than a partial unique index.
  isDefaultFirstOrderCampaign Boolean @default(false)
  firstOrderOnly              Boolean @default(true)

  // See PromotionStackingPolicy above -- NOT_STACKABLE by default, so a
  // newly-created campaign (including a first-order offer) can never
  // combine with another promotion until an admin deliberately changes it.
  stackingPolicy PromotionStackingPolicy @default(NOT_STACKABLE)

  // Empty array = every product eligible -- same convention as the
  // original FirstOrderOfferConfig.eligibleProductSlugs.
  eligibleProductSlugs String[] @default([])
  excludedProductSlugs String[] @default([])

  minPurchaseAmount Float?
  stackable         Boolean @default(false)
  maxUses           Int? // null = unlimited
  usesPerCustomer   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String?

  codes  PromotionCode[]
  claims FirstOrderOfferClaim[]

  @@index([status])
}

// One unique, single-redemption code per qualifying customer per campaign.
// discountType/discountValue/expiresAt are snapshotted at issuance from the
// campaign's state at that exact moment -- the same "snapshot so a later
// admin edit never rewrites what a customer was already promised"
// precedent already established by InvoiceDiscount and
// FirstOrderOfferClaim.percentage.
model PromotionCode {
  id   String @id @default(cuid())
  code String @unique

  campaign   PromotionCampaign @relation(fields: [campaignId], references: [id])
  campaignId String

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  discountType  PromotionType
  discountValue Float

  status    PromotionCodeStatus @default(ACTIVE)
  issuedAt  DateTime            @default(now())
  expiresAt DateTime?

  redeemedAt        DateTime?
  redeemedOrderId   String?
  redeemedInvoiceId String?

  revokedAt DateTime?
  revokedBy String?

  firstOrderOfferClaims FirstOrderOfferClaim[]
  // Back-relation for Order.appliedPromotionCodeId (Phase 4A Critical #1)
  // -- at most one Order can hold a given code at a time (the FK is
  // @unique on Order's side), so this is 0-or-1 in practice even though
  // Prisma models it as a list for the relation direction.
  appliedToOrder Order?

  @@index([campaignId])
  @@index([customerId])
}

// Single-purpose, expiring, revocable, admin-initiated invite that binds one
// Clerk User to one specific Customer record. Deliberately mirrors
// IntakeLink's proven shape (token-as-boundary, multi-field state derived
// from timestamps, never a separate status enum to keep in sync) rather than
// inventing a new pattern — see lib/portalInvites.ts / lib/portalInviteState.ts.
// The token alone never grants access: claimPortalInvite() additionally
// requires the authenticated Clerk session's own verified email to match
// customer.email before Customer.userId is ever set.
model CustomerPortalInvite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  token     String   @unique
  createdAt DateTime @default(now())
  createdBy String
  expiresAt DateTime

  claimedAt       DateTime?
  claimedByUserId String?
  revokedAt       DateTime?
  revokedBy       String?

  // Additive fields for the automated-onboarding rollout (Customer Identity
  // Platform). All default to values that make every pre-existing row behave
  // exactly as before: EMAIL-only, unreminded, admin-sourced.
  channel        PortalInviteChannel @default(EMAIL)
  remindersSent  Int                 @default(0)
  lastReminderAt DateTime?
  source         PortalInviteSource  @default(ADMIN)

  @@index([customerId])
}

enum PortalInviteChannel {
  EMAIL
  SMS
  BOTH
}

enum PortalInviteSource {
  ADMIN
  AUTO_ROLLOUT
}

// Every case where self-service account resolution (see
// lib/portal/selfServiceResolve.ts) could not safely auto-link a Clerk
// identity to a Customer record — multiple Customer rows sharing an email,
// or a link target already claimed by someone else. Deliberately one model
// for every "needs a human" reason rather than a table per reason, mirroring
// CustomerActivityLog's single-table-many-eventType-strings philosophy.
// Never auto-resolved: an admin explicitly approves, manually links, or
// dismisses each case (see app/api/admin/identity-review/[id]/route.ts).
model CustomerIdentityReviewCase {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  clerkUserId          String
  verifiedEmail        String
  reason               IdentityReviewReason
  candidateCustomerIds Json // string[] of Customer.id — every plausible match, for admin review

  status     IdentityReviewStatus @default(OPEN)
  resolvedBy String?
  resolvedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([status])
  @@index([clerkUserId])
}

enum IdentityReviewReason {
  MULTIPLE_MATCHES
  ALREADY_LINKED_OTHER_USER
  ALREADY_LINKED_OTHER_CUSTOMER
}

enum IdentityReviewStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Singleton row gating the automated bulk-invitation rollout. Its existence
// (activatedAt set) is the one explicit, admin-triggered action that turns
// on real sends — the audience-computation and dry-run logic run regardless,
// but app/api/cron/portal-invite-rollout/route.ts refuses to send anything
// for real until this row is activated. Deliberately a DB row, not just an
// env flag, so activation is itself audited (activatedBy/activatedAt) rather
// than a redeploy-only toggle.
model PortalRolloutSettings {
  id          String    @id @default(cuid())
  activatedAt DateTime?
  activatedBy String?

  // Batch pause/resume (Issue 5 safeguard, 2026-08-06 incident review) --
  // an admin-facing stop that doesn't require deactivating the whole
  // rollout. Independent of CUSTOMER_ROLLOUT_KILL_SWITCH (an env-var-level
  // stop that needs no DB write and survives even if this row is
  // unreachable) -- two separate layers, deliberately redundant.
  pausedAt DateTime?
  pausedBy String?

  // The exact eligible-customer-id list computed and shown to the admin at
  // the moment they activated -- captured once, never recomputed. The
  // rollout cron only ever sends to ids in this snapshot (intersected with
  // still-currently-eligible, so a customer who claims or gets disabled in
  // the interim is still excluded), so what was approved is provably what
  // can be sent, not a live query that could have silently grown.
  audienceSnapshot Json?
}

enum PreferredContactMethod {
  SMS
  EMAIL
  PHONE
}

enum CustomerStatus {
  LEAD
  INTAKE_SENT
  INTAKE_COMPLETED
  AWAITING_FULFILLMENT
  INVOICE_ISSUED
  AWAITING_PAYMENT
  PARTIALLY_PAID
  // A payment plan is on record with at least one installment still owed —
  // distinct from (and takes priority over) plain AWAITING_PAYMENT/
  // PARTIALLY_PAID, since it means fulfillment is already unlocked (see
  // lib/fulfillment/gate.ts) even though the invoice isn't paid off yet.
  PAYMENT_ARRANGEMENT
  PAID
  // Fulfillment Gate has passed (paid in full, or a manual override) but no
  // shipment has been created yet.
  ELIGIBLE_FOR_FULFILLMENT
  // A label has been purchased/registered but the carrier hasn't scanned it
  // yet — split out from PREPARING_SHIPMENT for more specific visibility.
  LABEL_CREATED
  PREPARING_SHIPMENT
  SHIPPED
  DELIVERED
  ARCHIVED
}

// CRM triage status (Phase 2B item 8) -- see Customer.leadStatus's own
// comment for why this is a separate enum from CustomerStatus above.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

// Permanent, append-only history for a customer — both lifecycle events
// (intake generated/viewed/submitted, invoice issued, payment received,
// shipment created/delivered, ...) and every outbound communication (intake/
// invoice/shipment emails, future SMS/calls). One unified table rather than
// two, since "what happened" and "what we sent" are the same timeline from
// the customer's point of view. Mirrors InvoiceActivityLog's shape (above)
// so it renders the same way in the UI. Nothing here is ever deleted.
model CustomerActivityLog {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])

  eventType     String
  previousValue String?
  newValue      String?
  source        TrackingEventSource
  userId        String?

  // Which shipment this entry refers to, when relevant — plain id, same
  // rationale as InvoiceActivityLog.shipmentId above.
  shipmentId String?

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
}

// ─── Customer Access / Auth Audit Trail ──────────────────────────────────────
// Auditable history of Clerk login/session lifecycle events, populated only
// by the Clerk webhook handler (app/api/webhooks/clerk/route.ts) — never
// written to directly. customerId is nullable because a Clerk user can
// generate events (e.g. sign up, sign in) before ever being linked to a
// Customer via claimPortalInvite() — those rows still matter for the audit
// trail and get backfilled conceptually by joining on clerkUserId. Deleting
// a Customer never deletes this history (no onDelete: Cascade) — same
// "disabling/unlinking never destroys history" guarantee CustomerActivityLog
// already gives, extended to auth events.
//
// Explicit hard constraint: this table must never store raw session tokens,
// authentication cookies, passkeys, or other credential material — only
// metadata about the fact that an event occurred.
model CustomerAccessEvent {
  id String @id @default(cuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  clerkUserId    String?
  clerkSessionId String?

  eventType CustomerAccessEventType

  // Clerk's own event timestamp vs. when our webhook actually received it —
  // kept distinct so retry/delivery delay is visible rather than masked.
  eventTimestamp DateTime
  receivedAt     DateTime @default(now())

  // Best-effort only — Clerk's webhook payloads do not reliably expose which
  // strategy (password/passkey/OTP/OAuth) was used for a given sign-in, so
  // this is frequently null. Documented limitation, not a bug.
  authMethod String?

  // Genuine end-customer device/location metadata, sourced only from
  // SessionJSON.latest_activity on session.* events — never from
  // event_attributes.http_request, which describes Clerk's own delivery
  // infrastructure calling our webhook, not the customer's client.
  deviceType     String?
  browserName    String?
  browserVersion String?
  ipAddress      String?
  city           String?
  country        String?

  emailAddress String?

  // Free-text outcome description (e.g. "revoked", "ended by user",
  // "removed") — the eventType already encodes the category; this captures
  // Clerk's finer-grained status when present.
  outcome String?

  providerEventId  String                      @unique // svix-id — the idempotency key
  processingStatus AccessEventProcessingStatus @default(PROCESSED)
  failureReason    String?

  // Free-text cross-reference to a related admin action (e.g. a
  // CustomerActivityLog id), when this event was a direct consequence of
  // one. Left null for ordinary Clerk-originated events.
  relatedAdminAction String?

  // "development" or "production" — read from the Clerk publishable key
  // prefix at processing time, not hardcoded, so the same code is correct
  // if/when the Clerk instance is promoted to production.
  environment String

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([clerkUserId, createdAt])
}

enum CustomerAccessEventType {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  SESSION_CREATED
  SESSION_ENDED
  SESSION_REMOVED
  SESSION_REVOKED
  EMAIL_CREATED
}

enum AccessEventProcessingStatus {
  PROCESSED
  FAILED
  IGNORED_DUPLICATE
}

// ─── Customer Intake Links ───────────────────────────────────────────────────
// Public, token-authenticated links a customer fills in themselves — see
// docs/Decisions.md. The token (not this row's id) is the entire security
// boundary, same pattern as the Shippo webhook's ?token= and CRON_SECRET.
// Multi-use until expiry/invalidation, not single-use, so a customer who
// doesn't finish — or an admin re-requesting info on an open draft — can
// reuse the same link.

model IntakeLink {
  id         String    @id @default(cuid())
  token      String    @unique
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])

  createdBy String

  expiresAt     DateTime
  // Set on the first GET — feeds the "Intake Viewed" timeline event and
  // intake analytics (completion rate, avg completion time).
  viewedAt      DateTime?
  invalidatedAt DateTime?
  submittedAt   DateTime?

  // Rejected past a small threshold — the primary spam defense is the
  // unguessable token itself; this just caps brute-force guessing attempts.
  submissionAttempts Int @default(0)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([invoiceId])
}

// ─── Admin Notifications ─────────────────────────────────────────────────────
// Pluggable NotificationChannel abstraction (lib/notifications/) — dashboard
// delivery is this row itself, email/SMS fan out to enabled
// AdminNotificationRecipient rows. See docs/Decisions.md.

model Notification {
  id         String    @id @default(cuid())
  type       String
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  isNewCustomer Boolean

  // Set when the widened duplicate-detection check (name/company/address
  // similarity, short of an exact email/phone match) flags a possible match
  // for admin review — never auto-merged, just surfaced. Holds the id of the
  // existing Customer it might duplicate.
  possibleDuplicateOf String?

  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([read, createdAt])
}

// A list, not a singleton — supports multiple administrators from day one.
// Configured entirely through Settings -> Admin Notifications; phone/email
// values are data entered through that form, never literals in code.
model AdminNotificationRecipient {
  id           String  @id @default(cuid())
  name         String?
  email        String?
  phone        String?
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Invoice Numbering ───────────────────────────────────────────────────────
// Replaces the previous count()-derived numbering in lib/invoice/numbering.ts,
// which silently reused a number if the invoice holding it was ever
// permanently deleted (the count simply dropped). One row per year,
// incremented atomically so concurrent creates can't race, and a delete can
// never free up a number for reuse.
model InvoiceNumberCounter {
  year         Int @id
  lastSequence Int @default(0)
}

// ─── Compliance ──────────────────────────────────────────────────────────────

model ComplianceAcknowledgment {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?
  ipAddress String?
  userAgent String?
  // Full RUO text the customer agreed to
  ruoText   String
  // Disclaimer version this acceptance covers (lib/compliance/ruo.ts's
  // RUO_VERSION at the time of acceptance). A signed-in User's acceptance
  // is checked per-version -- a later version bump requires renewed
  // acceptance without erasing the prior version's acceptance history.
  // Defaulted for backward compatibility with rows written before this
  // field existed (all real historical rows predate any version bump).
  version   String   @default("v1")
  // Source of this acceptance: "checkout" (per-order, guest or signed-in),
  // "standalone" (a signed-in customer's one-time acceptance recorded
  // outside any specific order, e.g. at first protected action).
  source    String   @default("checkout")
  agreedAt  DateTime @default(now())

  @@index([userId, version])
}

// ─── Accounting ──────────────────────────────────────────────────────────────

// Legacy, storefront-Order-flow-only expense log -- kept exactly as-is
// (still written by app/api/shipping/labels/route.ts and
// lib/payments/orderFulfillment.ts's markOrderPaid()). Left untouched
// rather than migrated into FinanceExpense below: the real sales history
// today is 100% Invoice-based (Order is pre-launch, all zero per
// app/admin/page.tsx's own comment), so there's nothing to backfill, and
// this table becomes populated automatically once real storefront orders
// start flowing -- see docs/PendingOwnerActions.md.
model Expense {
  id          String      @id @default(cuid())
  type        ExpenseType
  amount      Float
  description String?
  orderId     String?
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@index([type])
  @@index([date])
}

enum ExpenseType {
  SHIPPING
  COGS
  STRIPE_FEE
  REFUND
  OTHER
}

// ─── Finance & Expense Intelligence (2026-08-12 admin optimization sprint) ──
// The authoritative internal business-expense/financial-operations ledger --
// an operational recordkeeping and reporting system to support bookkeeping/
// tax preparation, not a certified accounting platform (spec explicit on
// this distinction). Deliberately separate from the legacy Order-only
// Expense model above (Invoice-capable, richer category taxonomy, receipts,
// accounting-treatment classification) and from InventoryPurchase below
// (COGS-feeding stock purchases are tracked there, never duplicated here --
// see FinanceAccountingTreatment.INVENTORY_COGS's own comment). Discounts,
// credits, refunds, and inventory loss are deliberately NOT modeled here --
// they're read directly from the existing InvoiceDiscount/
// BackorderCompensation/InvoiceRefund/InventoryLedgerEntry(DAMAGE_LOSS)
// records for reporting (lib/finance/reports.ts), so a discount or refund
// is never double-recorded as a second, drifting expense-ledger row.
model FinanceExpense {
  id String @id @default(cuid())

  date            DateTime
  vendor          String?
  description     String
  amount          Float
  category        FinanceExpenseCategory
  subcategory     String?
  paymentMethod   String?
  businessPurpose String?

  // Plain string references, matching the legacy Expense.orderId
  // convention above -- not enforced FKs, so linking an expense to a
  // record never requires editing that record's own model to add a
  // back-relation array. Any of these may be set; none are required (a
  // software subscription has none of them).
  orderId   String?
  invoiceId String?
  shipmentId String?
  productId String?

  notes        String?
  taxTreatment FinanceAccountingTreatment @default(NEEDS_ACCOUNTANT_REVIEW)

  // Single receipt/evidence reference (a pasted URL, not an uploaded file --
  // this repo has no file-storage integration today; see
  // docs/PendingOwnerActions.md for the real-upload gap). Nullable: most
  // categories don't require one and shouldn't be blocked by it.
  receiptUrl      String?
  receiptFilename String?

  // Idempotency key for provider-automated postings (e.g. a Shippo label
  // purchase's own transaction id) -- a second webhook/retry for the same
  // provider transaction can never create a duplicate expense row.
  providerReference String? @unique

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([invoiceId])
  @@index([orderId])
  @@index([taxTreatment])
}

enum FinanceExpenseCategory {
  SHIPPING_POSTAGE
  PACKAGING_FULFILLMENT
  INVENTORY_PRODUCT_PURCHASES
  RESEARCH_FULFILLMENT_SUPPLIES
  PAYMENT_PROCESSING
  SOFTWARE_TECHNOLOGY
  ADMINISTRATIVE_COMPLIANCE
  PROFESSIONAL_SERVICES
  ADVERTISING_MARKETING
  OFFICE_SUPPLIES
  EQUIPMENT_ASSETS
  PHILANTHROPY_DONATIONS
  OTHER_NEEDS_REVIEW
}

// Suggested internal treatment, never presented as guaranteed tax advice
// (spec explicit: "Needs Accountant Review" is a legitimate, common value,
// not a fallback to be avoided). INVENTORY_COGS exists here for
// classification completeness even though the *tracking* of real inventory
// purchases lives in InventoryPurchase, not FinanceExpense -- a rare
// resale-inventory-adjacent expense can still be tagged this way without
// creating a phantom InventoryPurchase row for it.
enum FinanceAccountingTreatment {
  OPERATING_EXPENSE
  INVENTORY_COGS
  CONTRA_REVENUE
  ASSET_CAPITAL_EXPENSE
  CHARITABLE_SEPARATE_TREATMENT
  NEEDS_ACCOUNTANT_REVIEW
}

// Stock purchases intended for resale, tracked separately from
// FinanceExpense specifically so a supplier case purchase is never
// double-counted as both "Inventory/COGS" and "Expense Ledger" (spec #27).
// Deliberately does NOT itself move physical stock -- linking to the
// InventoryLedgerEntry the admin's own "Add Stock" action already created
// (ledgerEntryId) keeps this a COGS/cost record layered on top of the
// existing inventory-adjustment system, not a second competing stock
// tracker.
model InventoryPurchase {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  supplier      String?
  sku           String?
  quantity      Int
  caseQuantity  Int?
  unitCost      Float
  totalCost     Float
  receiptUrl    String?
  invoiceRef    String?
  receivedAt    DateTime

  // The InventoryLedgerEntry (eventType ADD_STOCK) this purchase's physical
  // units were recorded against, if the admin created both in the same
  // action -- optional because a purchase can be logged for COGS purposes
  // before the physical stock is actually received/counted.
  ledgerEntryId String?

  notes     String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([receivedAt])
}

// Inventory loss/shrinkage is deliberately NOT modeled here -- it's already
// tracked via InventoryLedgerEntry's eventType DAMAGE_LOSS (lib/inventory/
// actions.ts's recordDamageLoss()), which records product/quantity/reason/
// date/actor exactly as this sprint's spec asks for. Finance reporting
// (lib/finance/reports.ts) reads those rows directly at cost basis
// (quantity x the product's supplierCaseCost-derived per-unit cost),
// never retail value, per the spec's explicit instruction.

// ─── Admin Audit Log ─────────────────────────────────────────────────────────

model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  adminId   String
  details   Json?
  createdAt DateTime @default(now())
}

// ─── Invoice Settings ────────────────────────────────────────────────────────
// Single-row table (always fetched/upserted by the fixed id below) rather than
// a generic key-value settings table — there's exactly one invoice-related
// setting today, and a dedicated typed column beats an untyped JSON blob for
// the one value that exists.
model InvoiceSettings {
  id String @id @default("singleton")

  // Days after paidAt before a PAID invoice auto-archives; null = never
  // auto-archive. See docs/Decisions.md #21.
  archiveAfterDays Int? @default(30)

  // Per-ShippingStatus on/off toggle for customer notification emails, e.g.
  // {"DELAYED": false}. A status missing from this map is treated as
  // enabled — so the default (empty/null) is "everything on" without
  // needing to seed every enum value. See lib/tracking/notifications.ts.
  trackingNotificationsEnabled Json?

  // Auto-email the Client Invoice PDF to customerEmail the first time an
  // invoice reaches ISSUED/PAID/PARTIALLY_PAID. Off doesn't touch the manual
  // "Email Invoice to Customer" button — that always works regardless.
  autoEmailInvoiceOnIssue Boolean @default(true)

  // Default lifespan of a generated customer intake link before it stops
  // accepting submissions (still regenerable). See docs/Decisions.md.
  defaultIntakeLinkExpiryHours Int @default(48)

  // Auto-email the customer once a payment is recorded on their invoice.
  // Off doesn't touch manual actions — same "toggle only affects the
  // automatic send" shape as autoEmailInvoiceOnIssue.
  autoEmailPaymentReceived Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ─── Fulfillment Settings ────────────────────────────────────────────────────
// Package defaults + the return/sender address used for every Shippo rate
// request and label purchase — admin-editable so it never requires a
// redeploy, same reasoning as InvoiceSettings above. Singleton, same pattern.
model FulfillmentSettings {
  id String @id @default("singleton")

  // { name, street1, street2?, city, state, zip, country, phone?, email? } —
  // shape matches lib/shippo.ts's AddressInput exactly.
  returnAddress Json?

  defaultCarrier  ShippingCarrier?
  defaultService  String?
  defaultWeightOz Float?
  defaultLengthIn Float?
  defaultWidthIn  Float?
  defaultHeightIn Float?

  // 2026-08-13 (Fulfillment Command Center) -- configurable SLA thresholds,
  // admin-editable rather than hardcoded, per that sprint's explicit
  // instruction. All in hours. Defaults reflect current real business
  // behavior, not an arbitrary guess:
  //   labelNeededHours: a paid order with no shipping label/tracking yet
  //     escalates from "Needs Fulfillment" to the "Label Needed" alert.
  //   awaitingScanHours: a label exists but no carrier acceptance/scan has
  //     been detected yet -- escalates to "Stalled" past this.
  //   stalledInTransitHours: a shipment has real carrier movement but no
  //     NEW event since this long -- escalates to "Stalled."
  labelNeededHours      Int @default(24)
  awaitingScanHours     Int @default(24)
  stalledInTransitHours Int @default(72)

  updatedAt DateTime @updatedAt
}

// ─── Fulfillment Command Center (2026-08-13) ─────────────────────────────────
// Deduplicated, resolvable operational alerts for paid orders whose
// fulfillment is at risk -- modeled directly on LowStockAlert's own
// "OPEN/RESOLVED, service-layer-enforced no-duplicate-unresolved-alert"
// idiom (see that model's comment) rather than the customer-intake-shaped
// Notification model, which doesn't fit (required isNewCustomer field, no
// resolve state). lib/fulfillment/alerts.ts is the only writer.
model FulfillmentAlert {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Set for shipment-scoped alert types (AWAITING_CARRIER_SCAN,
  // STALLED_NO_MOVEMENT, CARRIER_EXCEPTION) -- null for invoice-scoped ones
  // (NO_LABEL, INVENTORY_CONFLICT, REFUNDED_AFTER_SHIPMENT), which have no
  // single shipment to point at (or predate one existing at all). Plain id,
  // no FK relation -- same informational-only precedent as
  // InvoiceActivityLog.shipmentId.
  shipmentId String?

  alertType FulfillmentAlertType
  status    FulfillmentAlertStatus @default(OPEN)
  message   String

  createdAt     DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?
  resolutionNote String?

  // One open alert per (invoice, type) at a time -- reconcileFulfillmentAlerts()
  // enforces this at the service layer (find-open-before-create), same
  // precedent as BackorderCondition/LowStockAlert; not a DB unique index
  // since RESOLVED history for the same (invoice, type) must be allowed to
  // accumulate across separate incidents.
  @@index([invoiceId, status])
  @@index([status, alertType])
}

enum FulfillmentAlertType {
  NO_LABEL
  AWAITING_CARRIER_SCAN
  STALLED_NO_MOVEMENT
  CARRIER_EXCEPTION
  INVENTORY_CONFLICT
  REFUNDED_AFTER_SHIPMENT
}

enum FulfillmentAlertStatus {
  OPEN
  RESOLVED
}

// Reusable named package templates (e.g. "Small Box", "Padded Envelope") —
// same "reusable template, not retyped every time" reasoning as Promotion.
model PackagePreset {
  id       String  @id @default(cuid())
  name     String
  weightOz Float
  lengthIn Float?
  widthIn  Float?
  heightIn Float?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Correspondence History ──────────────────────────────────────────────────
// The authoritative record of every customer-facing (and admin-alert) email
// or SMS Pepscore has actually sent. Resend delivers directly through its
// own infrastructure, not through Google Workspace SMTP, so these messages
// never appear in the admin@ Gmail Sent folder — this table, not Workspace,
// is the only place "did we actually send this, and what did it say" can be
// answered. Written once per send attempt by lib/notifications/log.ts's
// sendCategorizedEmail/sendCategorizedSms — never edited afterward; a retry
// creates a new row (linked via retryOfId), it never overwrites the original.
model Communication {
  id String @id @default(cuid())

  channel  CommunicationChannel
  category String // a lib/notifications/routing.ts MessageCategory value — stored
  // as a plain string (not a Prisma enum) so adding a new category never
  // requires a migration, matching InvoiceActivityLog/CustomerActivityLog's
  // existing eventType convention elsewhere in this schema.
  status   CommunicationStatus

  fromAddress String?
  fromName    String?
  replyTo     String?
  toAddress   String
  subject     String?
  // The exact rendered HTML (email) or message text (SMS) that was sent —
  // an immutable snapshot, so "what did the customer actually receive"
  // never depends on the current state of the template that generated it.
  body        String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Soft references (plain ids, no FK) to whichever specific record this
  // message was actually about — same "never trust a live FK to survive an
  // unrelated edit or deletion" posture as BackorderCondition.invoiceItemId.
  relatedPaymentId            String?
  relatedRefundId             String?
  relatedBackorderConditionId String?
  relatedIntakeLinkId         String?

  providerName      String? // 'resend' | 'twilio'
  providerMessageId String?
  failureReason     String?
  retryOfId         String? // points at the original Communication this retry is for

  actorType   TrackingEventSource // reuse: MANUAL (an admin action triggered the send) or SYSTEM
  actorUserId String?

  sentAt DateTime @default(now())

  @@index([customerId, sentAt])
  @@index([invoiceId, sentAt])
  @@index([category])
  @@index([providerMessageId])
  // Supports the admin dashboard's 7-day sent/failed count
  // (lib/adminDashboard.ts's getAdminOperationsSummary), which filters on
  // status and sentAt with no customerId/invoiceId equality clause -- none
  // of the indexes above have status/sentAt as a leading column without
  // one of those, so that query previously forced a sequential scan.
  @@index([status, sentAt])
}

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationStatus {
  SENT
  FAILED
  SKIPPED
}

// ─── AI Foundation (AI-0B, 2026-08-18) ──────────────────────────────────────
// Structured, privacy-conscious event logging for the AI policy/provider
// layer -- lib/ai/compliance/ and lib/ai/usage/. Purely additive: neither
// model below is referenced by, or adds a field/relation to, any existing
// model in this file (matches AdminAuditLog.adminId's plain-string-no-
// relation convention, not CustomerAccessEvent's FK-relation one, so the
// User model itself needs zero changes).
//
// AiComplianceEvent deliberately does NOT store raw prompt text (owner
// decision, 2026-08-18 item 4) -- structured classification/policy
// metadata only. A future compliance-review feature that genuinely needs
// prompt retention requires a separate, narrowly-scoped owner-approved
// design (retention duration, access controls, deletion policy) before any
// such field is added here.
//
// AiPolicyCategory/AiPolicyAction are real enums, not free strings like
// Communication.category -- unlike that field (deliberately migration-free
// so routine new categories don't need a schema change), this taxonomy is
// explicitly fixed by owner decision ("do not expand this casually"), so a
// migration gate on adding a new category is the intended behavior, not
// friction to route around.
model AiComplianceEvent {
  id                   String           @id @default(cuid())
  userId               String?
  sessionId            String?
  policyCategory       AiPolicyCategory
  policyAction         AiPolicyAction
  feature              String
  classifierConfidence Float?
  classifierMethod     String?
  repeatCount          Int              @default(1)
  reviewStatus         AiReviewStatus   @default(UNREVIEWED)
  createdAt            DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([policyCategory, createdAt])
}

enum AiPolicyCategory {
  CATALOG
  RESEARCH
  LITERATURE
  ACCOUNT
  ADMIN
  HUMAN_USE
  JAILBREAK
  PROMPT_INJECTION
  UNKNOWN
}

enum AiPolicyAction {
  ALLOW
  REFUSE
  ESCALATE
}

enum AiReviewStatus {
  UNREVIEWED
  REVIEWED
  ESCALATED_TO_OWNER
}

model AiUsageEvent {
  id                 String   @id @default(cuid())
  userId             String?
  provider           String
  model              String
  feature            String
  inputTokens        Int
  outputTokens       Int
  latencyMs          Int
  estimatedCostCents Int
  success            Boolean
  usedFallback       Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
  @@index([provider, model, createdAt])
}

// ─── First-Party Search Analytics (AI-1.1, 2026-08-18) ──────────────────────
// The existing SEARCH analytics event (lib/analytics/events.ts) only ever
// went to @vercel/analytics -- a third-party hosted dashboard, not a
// queryable first-party data source. There was no way for this app itself
// (an admin page, or a future AI-1 "search-demand analysis"/"zero-result
// search insights" capability) to read what people actually searched for.
// This is that first-party record -- logged once per full /search page
// view (app/search/page.tsx), not per keystroke, so it adds zero latency
// to the existing fast, client-side-only predictive search.
model SearchEvent {
  id          String   @id @default(cuid())
  query       String
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([resultCount, createdAt])
}
