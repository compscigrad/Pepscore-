{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/api/webhooks/stripe",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://hooks.stripe.com" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/archive-invoices",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/poll-tracking",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/portal-invite-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/portal-invite-rollout",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/promotion-campaign-schedule",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/release-abandoned-reservations",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/first-order-offer-reminders",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/birthday-promotions",
      "schedule": "0 13 * * *"
    }
  ]
}
